@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero -->
<section class="hero d-flex align-items-center text-white">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">Ponete en forma con GymCore</h1>
                <p class="lead mb-4">Planes flexibles, entrenadores calificados y un ambiente pensado para que progreses.</p>
                <a class="btn btn-primary btn-lg me-2" asp-page="/Socios/Socios">Ver socios</a>
                <a class="btn btn-outline-light btn-lg" href="#planes">Ver planes</a>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-card card bg-dark bg-opacity-50 border-0">
                    <div class="card-body">
                        <h5 class="card-title text-white">Horarios de atención</h5>
                        <ul class="list-unstyled mb-0 text-white-50">
                            <li>Lunes a Viernes: 7:00 - 22:00</li>
                            <li>Sábado: 9:00 - 14:00</li>
                            <li>Domingo: Cerrado</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-bg"></div>
    
</section>

<!-- Beneficios / Servicios -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-semibold">Todo lo que necesitás</h2>
            <p class="text-muted">Infraestructura completa y equipo profesional a tu alcance.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Entrenadores certificados</h5>
                        <p class="card-text">Acompañamiento personalizado para que entrenes seguro y con resultados.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Equipamiento de primera</h5>
                        <p class="card-text">Máquinas modernas, pesos libres y zona funcional para todos los niveles.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Planes a tu medida</h5>
                        <p class="card-text">Suscripciones mensuales, trimestrales o anuales. Elegís cómo y cuándo entrenar.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Planes CTA -->
<section id="planes" class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h3 class="mb-2">Probá una semana gratis</h3>
                <p class="text-muted mb-0">Acercate al gimnasio y activamos tu pase sin cargo para que conozcas todo lo que ofrecemos.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a class="btn btn-primary btn-lg" href="#">Comenzar ahora</a>
            </div>
        </div>
    </div>
    
</section>

<!-- FAQ breve -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="accordion" id="faq">
            <div class="accordion-item">
                <h2 class="accordion-header" id="faq1">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1c" aria-expanded="true" aria-controls="faq1c">
                        ¿Necesito experiencia previa?
                    </button>
                </h2>
                <div id="faq1c" class="accordion-collapse collapse show" aria-labelledby="faq1" data-bs-parent="#faq">
                    <div class="accordion-body">
                        Para nada. Tenemos rutinas para principiantes y acompañamiento en sala para tus primeras clases.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="faq2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2c" aria-expanded="false" aria-controls="faq2c">
                        ¿Qué incluye la suscripción?
                    </button>
                </h2>
                <div id="faq2c" class="accordion-collapse collapse" aria-labelledby="faq2" data-bs-parent="#faq">
                    <div class="accordion-body">
                        Acceso libre a sala de musculación, clases grupales seleccionadas y seguimiento básico.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

