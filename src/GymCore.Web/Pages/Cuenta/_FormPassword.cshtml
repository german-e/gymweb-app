@model GymCore.Web.Pages.Cuenta.CambiarPasswordModel
<form method="post" novalidate data-submit-loading>
    <input type="hidden" asp-for="Obligatorio" />
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" id="usuarioActual" value="@Model.NombreUsuario" />
    <div class="mb-3">
        <label asp-for="Actual" class="form-label fw-semibold small"></label>
        <div class="auth-input no-icon">
            <input asp-for="Actual" id="pwdActual" class="form-control" autocomplete="current-password" autofocus />
            <button type="button" class="auth-input__toggle" data-toggle-password="#pwdActual" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Actual" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nueva" class="form-label fw-semibold small"></label>
        <div class="auth-input no-icon">
            <input asp-for="Nueva" id="pwdNueva" class="form-control" autocomplete="new-password" data-password-policy="#politica" data-password-user="#usuarioActual" />
            <button type="button" class="auth-input__toggle" data-toggle-password="#pwdNueva" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Nueva" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Confirmacion" class="form-label fw-semibold small"></label>
        <input asp-for="Confirmacion" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Confirmacion" class="text-danger small"></span>
    </div>
    <partial name="Components/_PoliticaPassword" />
    <button type="submit" class="primary-btn border-0 w-100 mt-4" data-loading-text="Guardando…"><i class="bi bi-check2"></i> Guardar contraseña</button>
</form>
