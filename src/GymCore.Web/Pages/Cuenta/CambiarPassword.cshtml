@page
@model GymCore.Web.Pages.Cuenta.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    if (Model.Obligatorio) Layout = "_LayoutCuenta";
}

@if (Model.Obligatorio)
{
    <section class="auth-card" aria-labelledby="pwdTitle">
        <header class="auth-card__head">
            <span class="eyebrow warning"><i class="bi bi-key"></i> Paso obligatorio</span>
            <h1 id="pwdTitle" class="mt-3">Elegí tu contraseña</h1>
            <p>Ingresaste con una contraseña temporal. Reemplazala por una propia para continuar.</p>
        </header>
        <partial name="_FormPassword" model="Model" />
        <form method="post" asp-page="Logout" class="text-center mt-3">
            <button type="submit" class="btn btn-link btn-sm text-muted">Cerrar sesión</button>
        </form>
    </section>
}
else
{
    <section class="page-shell">
        <div class="page-header">
            <div>
                <a class="text-decoration-none small fw-semibold" asp-page="Perfil"><i class="bi bi-arrow-left"></i> Mi perfil</a>
                <h2>Cambiar contraseña</h2>
                <p>Al cambiarla se cierran las sesiones abiertas en otros dispositivos.</p>
            </div>
        </div>
        <div class="data-card narrow-card p-4">
            <partial name="_FormPassword" model="Model" />
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
