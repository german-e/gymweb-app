@page
@model GymCore.Web.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutCuenta";
}

<section class="auth-card" aria-labelledby="loginTitle">
    <header class="auth-card__head">
        <h1 id="loginTitle">Bienvenido de nuevo</h1>
        <p>Ingresá con tu usuario para gestionar el gimnasio.</p>
    </header>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="flash success" role="status"><i class="bi bi-check-circle-fill"></i> @Model.Mensaje</div>
    }
    @if (Model.Error is not null)
    {
        <div class="flash @(Model.Bloqueado ? "warning-flash" : "danger")" role="alert">
            <i class="bi @(Model.Bloqueado ? "bi-lock-fill" : "bi-exclamation-triangle-fill")"></i>
            <span>@Model.Error</span>
        </div>
    }

    <form method="post" novalidate data-submit-loading>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label"></label>
            <div class="auth-input">
                <i class="bi bi-person"></i>
                <input asp-for="NombreUsuario" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus placeholder="ej. recepcion1" />
            </div>
            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="auth-input">
                <i class="bi bi-key"></i>
                <input asp-for="Password" id="password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <button type="button" class="auth-input__toggle" data-toggle-password="#password" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check m-0">
                <input asp-for="Recordar" class="form-check-input" />
                <label asp-for="Recordar" class="form-check-label small">Recordar sesión</label>
            </div>
            <span class="small text-muted" data-bs-toggle="tooltip" title="Pedile a un administrador que restablezca tu contraseña">¿Olvidaste tu contraseña?</span>
        </div>
        <button type="submit" class="primary-btn border-0 w-100 auth-submit" data-loading-text="Ingresando…">
            Iniciar sesión <i class="bi bi-arrow-right"></i>
        </button>
    </form>

    <p class="auth-hint"><i class="bi bi-shield-lock"></i> Por seguridad, la cuenta se bloquea temporalmente tras varios intentos fallidos.</p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
