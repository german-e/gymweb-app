@page "{id:int}"
@using GymCore.Web.Pages.Pagos
@using GymCore.Web.Pages.Socios
@model GymCore.Web.Pages.Ventas.TicketModel
@inject IUsuarioActual Usuario
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject GymCore.Web.Marca.ServicioBranding Marca
@{
    var v = Model.Venta;
    ViewData["Title"] = $"Ticket {v.Numero}";
    var marcaGym = await Marca.ActualAsync();
    var gimnasio = marcaGym.Nombre;
    var local = v.Fecha.ToLocalTime();
    var cliente = GymCore.Web.Comercial.ServicioVentas.Cliente(v, v.Socio);
    var puedeAnular = !v.Anulada && Usuario.Puede(Permisos.VentasAnular);
    var cuota = Model.Cuota;
    var unidades = v.Items.Sum(i => i.Cantidad);
}

<section class="page-shell">
    <div class="page-header d-print-none">
        <div>
            @if (Usuario.Puede(Permisos.VentasVer))
            {
                <a class="text-decoration-none small fw-semibold" asp-page="Index"><i class="bi bi-arrow-left"></i> Ventas</a>
            }
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2>Ticket @v.Numero</h2>
                @if (v.Anulada) { <span class="status-pill void mt-2">ANULADA</span> }
                else { <span class="status-pill success mt-2"><i class="bi bi-check-circle"></i> Cobrada</span> }
            </div>
            <p>@cliente · @local.ToString("dd/MM/yyyy HH:mm") · @v.Medio.Texto()</p>
        </div>
        <div class="header-actions">
            <button type="button" class="secondary-btn" data-imprimir><i class="bi bi-printer"></i> Imprimir ticket</button>
            @if (Usuario.Puede(Permisos.VentasCrear))
            {
                <a class="primary-btn" asp-page="Pos"><i class="bi bi-cart-plus"></i> Nueva venta</a>
            }
        </div>
    </div>

    @if (Model.Nuevo && !v.Anulada)
    {
        <div class="flash success d-print-none" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>Venta cobrada: <strong>@InventarioPresentacion.Precio(v.Total)</strong> en @v.Medio.Texto().@(unidades > 0 ? " El stock ya se descontó." : "")</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="flash success d-print-none" role="status"><i class="bi bi-check-circle-fill"></i> @Model.Flash</div>
    }
    @if (!string.IsNullOrEmpty(Model.FlashError))
    {
        <div class="flash danger d-print-none" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> @Model.FlashError</div>
    }
    @if (v.Anulada)
    {
        <div class="flash void-flash d-print-none" role="status">
            <i class="bi bi-x-octagon-fill"></i>
            <span>Venta anulada el <strong>@v.FechaAnulacion?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> por <strong>@v.UsuarioAnulo</strong>. Motivo: @v.MotivoAnulacion. El stock volvió al inventario y no suma en reportes.</span>
        </div>
    }

    <div class="receipt-layout">
        @* ============ TICKET (formato impresora térmica 80 mm) ============ *@
        <article class="thermal-ticket @(v.Anulada ? "is-anulado" : "")" id="ticket" aria-label="Ticket @v.Numero">
            @if (v.Anulada) { <div class="thermal-ticket__void" aria-hidden="true">ANULADA</div> }
            <header class="thermal-ticket__head">
                @if (marcaGym.Logo is { } logoT) { <img class="thermal-ticket__logo" src="@logoT" alt="" /> }
                <strong>@gimnasio</strong>
                @if (!string.IsNullOrEmpty(marcaGym.Contacto)) { <small>@marcaGym.Contacto</small> }
                <small>Comprobante no válido como factura</small>
            </header>
            <dl class="thermal-ticket__meta">
                <div><dt>Ticket</dt><dd>@v.Numero</dd></div>
                <div><dt>Fecha</dt><dd>@local.ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div><dt>Cliente</dt><dd>@cliente</dd></div>
                @if (v.Socio is { } s)
                {
                    <div><dt>N° socio</dt><dd>@SocioPresentacion.Numero(s.NumeroVisible)</dd></div>
                }
                <div><dt>Atendió</dt><dd>@(v.Usuario ?? "—")</dd></div>
            </dl>
            <table class="thermal-ticket__items">
                <thead><tr><th>Cant.</th><th>Descripción</th><th class="text-end">Importe</th></tr></thead>
                <tbody>
                    @foreach (var i in v.Items)
                    {
                        <tr>
                            <td>@i.Cantidad</td>
                            <td>@i.Descripcion @if (i.Cantidad > 1) { <small>@InventarioPresentacion.Precio(i.PrecioUnitario) c/u</small> }</td>
                            <td class="text-end">@InventarioPresentacion.Precio(i.Subtotal)</td>
                        </tr>
                    }
                    @if (cuota is not null)
                    {
                        <tr>
                            <td>1</td>
                            <td>Cuota @(cuota.SocioPlan?.Plan.Nombre ?? "· pago a cuenta") <small>Recibo @cuota.Numero()@(cuota.Anulado ? " · anulado" : "")</small></td>
                            <td class="text-end">@InventarioPresentacion.Precio(cuota.Importe)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="thermal-ticket__total">
                <span>TOTAL</span>
                <strong>@InventarioPresentacion.Precio(v.Total)</strong>
            </div>
            <dl class="thermal-ticket__meta">
                <div><dt>Medio de pago</dt><dd>@v.Medio.Texto()</dd></div>
                @if (unidades > 0)
                {
                    <div><dt>Artículos</dt><dd>@unidades</dd></div>
                }
            </dl>
            @if (!string.IsNullOrEmpty(v.Observaciones))
            {
                <p class="thermal-ticket__obs">@v.Observaciones</p>
            }
            <footer class="thermal-ticket__foot">¡Gracias por tu compra!</footer>
        </article>

        @* ============ PANEL LATERAL ============ *@
        <aside class="receipt-aside d-print-none">
            <div class="panel-card audit-card">
                <div class="panel-head mb-3">
                    <h3><i class="bi bi-shield-check"></i> Auditoría de la venta</h3>
                    @if (v.Anulada) { <span class="status-pill void">Anulada</span> } else { <span class="status-pill success">Trazable</span> }
                </div>
                <dl class="audit-list">
                    <div><dt><i class="bi bi-hash"></i> Operación</dt><dd class="font-monospace">@v.Numero</dd></div>
                    <div><dt><i class="bi bi-calendar3"></i> Fecha</dt><dd class="num">@local.ToString("dd/MM/yyyy HH:mm:ss")</dd></div>
                    <div><dt><i class="bi bi-person-check"></i> Cajero</dt><dd><span class="audit-user"><span class="avatar-circle sm">@UsuarioActual.InicialesDe(v.Usuario ?? "?")</span> @(v.Usuario ?? "—")</span></dd></div>
                    <div><dt><i class="bi bi-shop"></i> Canal</dt><dd>@(v.Canal == GymCore.Dominio.Entidades.CanalVenta.Online ? "Online" : "Mostrador")</dd></div>
                    @if (cuota is not null)
                    {
                        <div><dt><i class="bi bi-card-checklist"></i> Cuota incluida</dt><dd><a asp-page="/Pagos/Recibo" asp-route-id="@cuota.Id">@cuota.Numero()</a>@(cuota.Anulado ? " · anulado" : "")</dd></div>
                    }
                    @if (v.Anulada)
                    {
                        <div class="audit-void"><dt><i class="bi bi-x-octagon"></i> Anulada el</dt><dd class="num">@v.FechaAnulacion?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd></div>
                        <div class="audit-void"><dt><i class="bi bi-person-x"></i> Anuló</dt><dd>@v.UsuarioAnulo</dd></div>
                        <div class="audit-void"><dt><i class="bi bi-chat-left-text"></i> Motivo</dt><dd>@v.MotivoAnulacion</dd></div>
                    }
                </dl>
            </div>

            @if (v.Socio is { } socio)
            {
                <div class="panel-card">
                    <div class="person-cell">
                        <partial name="Components/_Avatar" model='new AvatarVm(socio.FotoUrl, socio.Iniciales, "lg", socio.NombreCompleto)' />
                        <div class="person-cell__copy">
                            <a class="fw-semibold" asp-page="/Socios/Detalle" asp-route-id="@socio.Id" asp-fragment="tab-compras">@socio.NombreCompleto</a>
                            <small>DNI @socio.Dni · N° @SocioPresentacion.Numero(socio.NumeroVisible)</small>
                        </div>
                    </div>
                </div>
            }

            <div class="panel-card">
                <div class="panel-head mb-3"><h3>Acciones</h3></div>
                <div class="quick-actions single">
                    <button type="button" class="quick-action" data-imprimir>
                        <i class="bi bi-printer"></i><span>Imprimir ticket<small>Formato de impresora térmica 80 mm</small></span>
                    </button>
                    @if (Usuario.Puede(Permisos.VentasCrear))
                    {
                        <a class="quick-action success" asp-page="Pos" asp-route-socioId="@v.SocioId"><i class="bi bi-cart-plus"></i><span>Nueva venta<small>@(v.SocioId is null ? "Volver al Punto de Venta" : $"Para {cliente}")</small></span></a>
                    }
                    @if (puedeAnular)
                    {
                        <button type="button" class="quick-action danger" data-bs-toggle="modal" data-bs-target="#anularModal">
                            <i class="bi bi-x-octagon"></i><span>Anular venta<small>Repone el stock@(cuota is { Anulado: false } ? " y anula la cuota" : "")</small></span>
                        </button>
                    }
                </div>
            </div>

            @if (Model.Eventos.Count > 0)
            {
                <div class="panel-card">
                    <div class="panel-head mb-3"><h3>Historial</h3></div>
                    <partial name="Components/_EventosTimeline" model='new EventosTimelineVm(Model.Eventos, MostrarEntidad: false, Compacto: true)' />
                </div>
            }
        </aside>
    </div>
</section>

@if (puedeAnular)
{
    <div class="modal fade" id="anularModal" tabindex="-1" aria-labelledby="anularModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Anular" asp-route-id="@v.Id" class="modal-content" data-submit-loading data-anular-form>
                <div class="modal-body p-4">
                    <div class="d-flex gap-3 mb-3">
                        <div class="module-icon danger"><i class="bi bi-exclamation-triangle"></i></div>
                        <div>
                            <h5 class="mb-1" id="anularModalTitle">Confirmar anulación de la venta</h5>
                            <p class="text-muted small mb-0">
                                @v.Numero · @InventarioPresentacion.Precio(v.Total) · @cliente.
                                La venta no se borra: queda como <strong>anulada</strong>, @(unidades > 0 ? $"las {unidades} unidades vuelven al stock" : "no hay productos que reponer")@(cuota is { Anulado: false } ? " y la cuota incluida se anula" : "").
                            </p>
                        </div>
                    </div>
                    <label class="form-label fw-semibold small">Motivo de anulación<span class="text-danger">*</span></label>
                    <div class="motivo-picker" role="radiogroup" aria-label="Motivo de anulación">
                        @for (var i = 0; i < InventarioPresentacion.MotivosAnulacion.Length; i++)
                        {
                            var motivo = InventarioPresentacion.MotivosAnulacion[i];
                            <input type="radio" id="motivo-@i" name="motivo" value="@motivo" required />
                            <label for="motivo-@i">@motivo</label>
                        }
                    </div>
                    <label class="form-label fw-semibold small mt-3" for="anularDetalle">Detalle <span class="text-muted fw-normal" data-detalle-hint>(opcional)</span></label>
                    <textarea id="anularDetalle" name="detalle" class="form-control" rows="2" maxlength="250" placeholder="Ej.: el cliente devolvió la bebida sin abrir"></textarea>
                    <div class="form-text"><i class="bi bi-person-check"></i> Quedará registrado a nombre de <strong>@Usuario.Nombre</strong>.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger px-3" disabled data-anular-submit data-loading-text="Anulando…">Confirmar anulación</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/ventas.js" asp-append-version="true"></script>
    <script>
        // Motivo obligatorio; "Otro" exige detalle
        (function () {
            const form = document.querySelector('[data-anular-form]');
            if (!form) return;
            const submit = form.querySelector('[data-anular-submit]');
            const detalle = form.querySelector('#anularDetalle');
            const hint = form.querySelector('[data-detalle-hint]');
            const validar = () => {
                const m = form.querySelector('input[name="motivo"]:checked');
                const otro = m && m.value === 'Otro';
                hint.textContent = otro ? '(obligatorio)' : '(opcional)';
                detalle.required = !!otro;
                submit.disabled = !m || (otro && !detalle.value.trim());
            };
            form.addEventListener('change', validar);
            detalle.addEventListener('input', validar);
        })();
    </script>
}
