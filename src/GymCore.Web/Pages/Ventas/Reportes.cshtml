@page
@using GymCore.Web.Reportes
@model GymCore.Web.Pages.Ventas.ReportesModel
@{
    ViewData["Title"] = "Reportes comerciales";
    var r = Model.Reporte;
    var rentabilidad = r.Importe == 0 ? 0 : Math.Round(r.MargenTotal * 100 / r.Importe, 1);
    var ticket = r.Tickets == 0 ? 0 : Math.Round(r.Importe / r.Tickets, 0);
}

<section class="page-shell viz-root">
    <div class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-graph-up-arrow"></i> Ventas e inventario</span>
            <h2>Reportes comerciales</h2>
            <p>¿Cuánto vendo, qué se vende y cuánto me deja? Solo productos: la cuota cobrada en el ticket se analiza en Inteligencia de negocio. Ventas anuladas excluidas.</p>
        </div>
        <div class="header-actions">
            <a class="secondary-btn" asp-page="Index"><i class="bi bi-receipt"></i> Ventas</a>
        </div>
    </div>

    <div class="kpi-grid">
        <partial name="/Pages/Reportes/_KpiTile.cshtml" model="r.Hoy" />
        <partial name="/Pages/Reportes/_KpiTile.cshtml" model="r.Mes" />
        <partial name="/Pages/Reportes/_KpiTile.cshtml" model="r.Margen" />
        <partial name="/Pages/Reportes/_KpiTile.cshtml" model="r.Rentabilidad" />
    </div>

    <partial name="/Pages/Reportes/_FiltroPeriodo.cshtml" model="Model.Periodo" />

    @if (r.Importe == 0)
    {
        <div class="data-card"><partial name="Components/_EmptyState" model='new EmptyStateVm("bi-cart", "Sin ventas en el período", "Cuando registres ventas en el Punto de Venta vas a ver acá su evolución, los productos más vendidos y la rentabilidad.")' /></div>
    }
    else
    {
        <div class="panel-card viz-card">
            <div class="viz-card__head">
                <div>
                    <h3>Evolución mensual</h3>
                    <p>@Model.Periodo.Texto · ventas @MetricasNegocio.Dinero(r.Importe) · margen @MetricasNegocio.Dinero(r.MargenTotal) (@rentabilidad.ToString("0.#")%) · @r.Tickets tickets · ticket promedio @MetricasNegocio.Dinero(ticket)</p>
                </div>
                <ul class="viz-legend">
                    <li><span class="viz-key" style="background: var(--series-1)"></span> Ventas</li>
                    <li><span class="viz-key" style="background: var(--series-2)"></span> Margen estimado</li>
                </ul>
            </div>
            <partial name="/Pages/Reportes/_Viz.cshtml" model='new VizVm("bars", new { etiquetas = r.Meses.Select(m => Presentacion.Mes(m.Mes)), titulos = r.Meses.Select(m => Periodo.NombreMesLargo(m.Mes) + " " + m.Mes.Year + (m.Completo ? "" : " (parcial)")), formato = "dinero", series = new[] { new { nombre = "Ventas", valores = r.Meses.Select(m => (decimal?)m.Importe), slot = "1" }, new { nombre = "Margen estimado", valores = r.Meses.Select(m => (decimal?)m.Margen), slot = "2" } } }, "Ventas y margen estimado de productos por mes")' />
        </div>

        <div class="dashboard-grid">
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-trophy text-primary"></i> Productos más vendidos</h3><small class="text-soft">por unidades</small></div>
                <partial name="/Pages/Reportes/_BarrasH.cshtml" model='new BarrasHVm(r.MasVendidos.Select(f => new BarraH(f.Nombre, f.Unidades, $"{f.Unidades:N0} u.", $"{f.Categoria} · {MetricasNegocio.Dinero(f.Importe)}", Url.Page("/Ventas/Productos/Detalle", new { id = f.ProductoId }))).ToList(), "Productos más vendidos por unidades", Numerada: true)' />
            </div>
            <div class="panel-card viz-card">
                <div class="viz-card__head">
                    <div><h3>Ventas por categoría</h3><p>Participación en la facturación de productos</p></div>
                </div>
                <div class="donut-layout">
                    <partial name="/Pages/Reportes/_Viz.cshtml" model='new VizVm("donut", new { formato = "dinero", centroDetalle = "vendido", segmentos = Model.Distribucion.Select(d => new { nombre = d.Nombre, valor = d.Importe, slot = d.Slot }) }, "Distribución de las ventas por categoría", 200, Cuadrado: true)' />
                    <ul class="viz-legend vertical">
                        @foreach (var d in Model.Distribucion)
                        {
                            <li><span class="viz-key caja" style="background: var(--series-@d.Slot)"></span> <span class="text-truncate">@d.Nombre</span> <strong class="ms-auto num">@MetricasNegocio.Dinero(d.Importe)</strong> <small class="text-soft num">@d.Pct.ToString("0.#", Periodo.Es)%</small></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-piggy-bank text-primary"></i> Más rentables</h3><small class="text-soft">margen estimado del período</small></div>
                <partial name="/Pages/Reportes/_BarrasH.cshtml" model='new BarrasHVm(r.MasRentables.Select(f => new BarraH(f.Nombre, f.Margen, MetricasNegocio.Dinero(f.Margen), f.Importe > 0 ? $"{Math.Round(f.Margen * 100 / f.Importe, 1):0.#}% de margen" : null, Url.Page("/Ventas/Productos/Detalle", new { id = f.ProductoId }))).ToList(), "Productos con mayor margen estimado", Numerada: true)' />
            </div>
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-moon text-primary"></i> Sin ventas en el período</h3><small class="text-soft">@r.SinMovimiento.Count productos activos</small></div>
                @if (r.SinMovimiento.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="bi bi-check2-circle text-success"></i> Todos los productos activos se vendieron al menos una vez.</p>
                }
                else
                {
                    <ul class="plain-list">
                        @foreach (var f in r.SinMovimiento.Take(8))
                        {
                            <li><a asp-page="/Ventas/Productos/Detalle" asp-route-id="@f.ProductoId">@f.Nombre</a> <small class="text-soft">· @f.Categoria</small></li>
                        }
                    </ul>
                    @if (r.SinMovimiento.Count > 8) { <small class="text-soft">y @(r.SinMovimiento.Count - 8) más.</small> }
                    <p class="kpi-footnote mt-3 mb-0"><i class="bi bi-lightbulb"></i> Considerá destacarlos en el Punto de Venta, armar un combo o dejar de reponerlos.</p>
                }
            </div>
        </div>

        <div class="data-card">
            <div class="toolbar"><strong>Datos por mes</strong><span class="small text-muted">Equivalente en tabla del gráfico de evolución</span></div>
            <div class="table-responsive">
                <table class="data-table viz-data">
                    <thead><tr><th>Mes</th><th class="text-end">Ventas</th><th class="text-end">Margen estimado</th><th class="text-end">Rentabilidad</th><th class="text-end">Tickets</th></tr></thead>
                    <tbody>
                        @foreach (var m in r.Meses)
                        {
                            <tr>
                                <td>@Periodo.NombreMesLargo(m.Mes) @m.Mes.Year @if (!m.Completo) { <span class="badge-light ms-1">parcial</span> }</td>
                                <td class="text-end num fw-semibold">@MetricasNegocio.Dinero(m.Importe)</td>
                                <td class="text-end num">@MetricasNegocio.Dinero(m.Margen)</td>
                                <td class="text-end num">@(m.Importe > 0 ? $"{Math.Round(m.Margen * 100 / m.Importe, 1):0.#}%" : "—")</td>
                                <td class="text-end num">@m.Tickets</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th>Total</th><th class="text-end">@MetricasNegocio.Dinero(r.Importe)</th><th class="text-end">@MetricasNegocio.Dinero(r.MargenTotal)</th><th class="text-end">@rentabilidad.ToString("0.#")%</th><th class="text-end">@r.Tickets</th></tr></tfoot>
                </table>
            </div>
            <details class="viz-table">
                <summary>Ver categorías en tabla</summary>
                <table class="data-table viz-data">
                    <thead><tr><th>Categoría</th><th class="text-end">Unidades</th><th class="text-end">Ventas</th><th class="text-end">Margen</th><th class="text-end">Participación</th></tr></thead>
                    <tbody>
                        @foreach (var c in r.Categorias)
                        {
                            <tr>
                                <td>@c.Nombre</td>
                                <td class="text-end num">@c.Unidades.ToString("N0")</td>
                                <td class="text-end num">@MetricasNegocio.Dinero(c.Importe)</td>
                                <td class="text-end num">@MetricasNegocio.Dinero(c.Margen)</td>
                                <td class="text-end num">@(r.Importe > 0 ? $"{Math.Round(c.Importe * 100 / r.Importe, 1):0.#}%" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
            <details class="viz-table">
                <summary>Ver ranking de productos en tabla</summary>
                <table class="data-table viz-data">
                    <thead><tr><th>#</th><th>Producto</th><th>Categoría</th><th class="text-end">Unidades</th><th class="text-end">Ventas</th><th class="text-end">Margen</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < r.MasVendidos.Count; i++)
                        {
                            var f = r.MasVendidos[i];
                            <tr>
                                <td class="num">@(i + 1)</td>
                                <td>@f.Nombre</td>
                                <td class="text-soft">@f.Categoria</td>
                                <td class="text-end num">@f.Unidades.ToString("N0")</td>
                                <td class="text-end num">@MetricasNegocio.Dinero(f.Importe)</td>
                                <td class="text-end num">@MetricasNegocio.Dinero(f.Margen)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
