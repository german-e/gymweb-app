@page "{id:int}"
@using GymCore.Web.Pages.Entrenadores
@model GymCore.Web.Pages.Entrenadores.DetalleModel
@inject IUsuarioActual Usuario
@{
    var e = Model.Entrenador;
    ViewData["Title"] = e.NombreCompleto;
    var edad = EntrenadorPresentacion.Edad(e.FechaNacimiento);
    var certificaciones = e.ListaCertificaciones.ToList();
    var hoy = DateTime.Now.Date;

    string Relativo(DateTime utc)
    {
        var local = utc.ToLocalTime();
        var dias = (hoy - local.Date).Days;
        return dias switch
        {
            0 => $"Hoy, {local:HH:mm}",
            1 => $"Ayer, {local:HH:mm}",
            < 7 => $"Hace {dias} días",
            _ => local.ToString("dd/MM/yyyy")
        };
    }
}

<section class="page-shell">
    <a class="text-decoration-none small fw-semibold" asp-page="Index"><i class="bi bi-arrow-left"></i> Entrenadores</a>

    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="flash success" role="status"><i class="bi bi-check-circle-fill"></i> @Model.Flash</div>
    }

    @* ============ CABECERA ============ *@
    <header class="profile-hero">
        <div class="profile-hero__cover"></div>
        <div class="profile-hero__body">
            <partial name="Components/_Avatar" model='new AvatarVm(e.FotoUrl, e.Iniciales, "xl", e.NombreCompleto)' />
            <div class="profile-hero__info">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2>@e.NombreCompleto</h2>
                    <span class="status-pill @(e.Activo ? "success" : "muted")">@(e.Activo ? "Activo" : "Inactivo")</span>
                </div>
                <div class="profile-hero__meta">
                    <span><i class="bi bi-award"></i> @(e.Especialidad ?? "Sin especialidad")</span>
                    <span><i class="bi bi-calendar-check"></i> Ingreso @e.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    @if (!e.Activo && e.FechaBaja.HasValue)
                    {
                        <span class="text-danger"><i class="bi bi-calendar-x"></i> Baja @e.FechaBaja.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    }
                    <span><i class="bi bi-person-vcard"></i> DNI @e.Dni</span>
                </div>
            </div>
            <div class="profile-hero__actions">
                @if (Usuario.Puede(Permisos.EntrenadoresEditar))
                {
                <a class="secondary-btn" asp-page="Edit" asp-route-id="@e.Id"><i class="bi bi-pencil"></i> Editar</a>
                }
                @if (e.Activo && Usuario.Puede(Permisos.EntrenadoresEditar))
                {
                    <button type="button" class="primary-btn border-0" data-bs-toggle="modal" data-bs-target="#asignarModal"><i class="bi bi-person-plus"></i> Asignar socio</button>
                }
                @if (Usuario.Puede(Permisos.EntrenadoresEditar))
                {
                <div class="dropdown">
                    <button class="secondary-btn px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Más acciones"><i class="bi bi-three-dots"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button type="button" class="dropdown-item"
                                    data-confirm-action="@Url.Page("Detalle", "ToggleEstado", new { id = e.Id })"
                                    data-confirm-title="@(e.Activo ? "¿Desactivar entrenador?" : "¿Reactivar entrenador?")"
                                    data-confirm-text="@(e.Activo ? "No podrá recibir nuevas asignaciones. Se conservan sus socios e historial." : "Volverá a estar disponible para asignaciones.")"
                                    data-confirm-label="@(e.Activo ? "Desactivar" : "Reactivar")"
                                    data-confirm-variant="@(e.Activo ? "warning" : "success")">
                                <i class="bi @(e.Activo ? "bi-toggle-off" : "bi-toggle-on")"></i> @(e.Activo ? "Desactivar" : "Reactivar")
                            </button>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button type="button" class="dropdown-item text-danger"
                                    data-confirm-action="@Url.Page("Detalle", "Eliminar", new { id = e.Id })"
                                    data-confirm-title="¿Eliminar a @e.NombreCompleto?"
                                    data-confirm-text="Se borrarán sus asignaciones e historial de forma permanente. Si solo dejó de trabajar, preferí desactivarlo."
                                    data-confirm-label="Eliminar definitivamente"
                                    data-confirm-variant="danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </li>
                    </ul>
                </div>
                }
            </div>
        </div>
    </header>

    @* ============ TARJETAS RESUMEN ============ *@
    <div class="summary-grid">
        <div class="summary-card">
            <div class="module-icon primary"><i class="bi bi-people"></i></div>
            <div><p>Socios asignados</p><h4>@Model.Socios.Count</h4></div>
        </div>
        <div class="summary-card">
            <div class="module-icon info"><i class="bi bi-journal-text"></i></div>
            <div><p>Rutinas activas <span class="soon-badge">Pronto</span></p><h4 class="text-muted">—</h4></div>
        </div>
        <div class="summary-card">
            <div class="module-icon warning"><i class="bi bi-clock"></i></div>
            <div><p>Horas semanales</p><h4>@e.HorasSemanales.ToString("0.#") <small>h</small></h4></div>
        </div>
        <div class="summary-card">
            <div class="module-icon success"><i class="bi bi-hourglass-split"></i></div>
            <div><p>Antigüedad</p><h4>@EntrenadorPresentacion.Antiguedad(e.FechaAlta, e.Activo ? null : e.FechaBaja)</h4></div>
        </div>
    </div>

    @* ============ PESTAÑAS ============ *@
    <div class="data-card">
        <nav class="tabs-underline px-3" role="tablist">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-resumen" type="button" role="tab"><i class="bi bi-person-lines-fill"></i> Resumen</button>
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-socios" type="button" role="tab"><i class="bi bi-people"></i> Socios asignados <span class="count">@Model.Socios.Count</span></button>
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-historial" type="button" role="tab"><i class="bi bi-clock-history"></i> Historial</button>
            @* Módulos futuros: la estructura de pestañas ya los contempla *@
            <span class="nav-link disabled" aria-disabled="true"><i class="bi bi-journal-text"></i> Rutinas <span class="soon-badge">Pronto</span></span>
            <span class="nav-link disabled" aria-disabled="true"><i class="bi bi-calendar3"></i> Agenda <span class="soon-badge">Pronto</span></span>
            <span class="nav-link disabled" aria-disabled="true"><i class="bi bi-clipboard2-pulse"></i> Evaluaciones <span class="soon-badge">Pronto</span></span>
        </nav>

        <div class="tab-content">
            @* ---------- RESUMEN ---------- *@
            <div class="tab-pane fade show active p-4" id="tab-resumen" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <h6 class="fw-bold mb-3">Perfil profesional</h6>
                        @if (!string.IsNullOrEmpty(e.DescripcionProfesional))
                        {
                            <p class="mb-4" style="white-space: pre-line">@e.DescripcionProfesional</p>
                        }
                        else
                        {
                            <p class="text-muted mb-4">Sin descripción profesional. <a hidden="@(!Usuario.Puede(Permisos.EntrenadoresEditar))" asp-page="Edit" asp-route-id="@e.Id" asp-fragment="sec-profesional">Agregar</a></p>
                        }
                        <dl class="info-list mb-4">
                            <div><dt>Especialidad</dt><dd>@(e.Especialidad ?? "—")</dd></div>
                            <div><dt>Experiencia</dt><dd>@(e.AniosExperiencia.HasValue ? $"{e.AniosExperiencia} años" : "—")</dd></div>
                            <div class="full"><dt>Institución formadora</dt><dd>@(e.InstitucionFormadora ?? "—")</dd></div>
                            <div class="full">
                                <dt>Certificaciones</dt>
                                <dd>
                                    @if (certificaciones.Count == 0) { <text>—</text> }
                                    else
                                    {
                                        <div class="chip-list mt-1">
                                            @foreach (var c in certificaciones) { <span class="chip"><i class="bi bi-patch-check text-primary"></i> @c</span> }
                                        </div>
                                    }
                                </dd>
                            </div>
                            @if (!string.IsNullOrEmpty(e.Observaciones))
                            {
                                <div class="full"><dt>Observaciones internas</dt><dd style="white-space: pre-line">@e.Observaciones</dd></div>
                            }
                        </dl>

                        <h6 class="fw-bold mb-3">Disponibilidad</h6>
                        <div class="week-strip mb-2" aria-label="Días de trabajo">
                            @foreach (var d in EntrenadorPresentacion.Dias)
                            {
                                <span class="@(e.DiasTrabajo.HasFlag(d.Dia) ? "on" : "")" title="@d.Largo">@d.Corto</span>
                            }
                        </div>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-clock"></i> @EntrenadorPresentacion.HorarioTexto(e) · Turno @e.Turno.Texto()
                        </p>
                    </div>

                    <div class="col-lg-5">
                        <div class="panel-card p-3 shadow-none bg-light-subtle">
                            <h6 class="fw-bold mb-3">Contacto y datos personales</h6>
                            <dl class="info-list" style="grid-template-columns: 1fr">
                                <div><dt>Celular</dt><dd>@if (e.Celular is not null) { <a href="tel:@e.Celular">@e.Celular</a> } else { <text>—</text> }</dd></div>
                                <div><dt>Teléfono</dt><dd>@if (e.Telefono is not null) { <a href="tel:@e.Telefono">@e.Telefono</a> } else { <text>—</text> }</dd></div>
                                <div><dt>Email</dt><dd>@if (e.Email is not null) { <a href="mailto:@e.Email">@e.Email</a> } else { <text>—</text> }</dd></div>
                                <div><dt>Dirección</dt><dd>@(e.Direccion ?? "—")</dd></div>
                                <div><dt>Nacimiento</dt><dd>@(e.FechaNacimiento.HasValue ? $"{e.FechaNacimiento:dd/MM/yyyy} ({edad} años)" : "—")</dd></div>
                                <div><dt>Sexo</dt><dd>@e.Sexo.Texto()</dd></div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            @* ---------- SOCIOS ASIGNADOS ---------- *@
            <div class="tab-pane fade" id="tab-socios" role="tabpanel">
                @if (Model.Socios.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><i class="bi bi-people"></i></div>
                        <h4>Sin socios asignados</h4>
                        <p>Asigná socios para hacer seguimiento de sus objetivos, rutinas y asistencia.</p>
                        @if (e.Activo && Usuario.Puede(Permisos.EntrenadoresEditar))
                        {
                            <button type="button" class="primary-btn border-0" data-bs-toggle="modal" data-bs-target="#asignarModal"><i class="bi bi-person-plus"></i> Asignar socio</button>
                        }
                        else
                        {
                            <p class="small text-warning mb-0"><i class="bi bi-exclamation-triangle"></i> Reactivá al entrenador para asignarle socios.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="toolbar">
                        <label class="search-input" aria-label="Filtrar socios asignados">
                            <i class="bi bi-search"></i>
                            <input type="search" placeholder="Filtrar socios…" data-table-filter="#tablaSocios" />
                        </label>
                        @if (e.Activo && Usuario.Puede(Permisos.EntrenadoresEditar))
                        {
                            <button type="button" class="primary-btn border-0" data-bs-toggle="modal" data-bs-target="#asignarModal"><i class="bi bi-person-plus"></i> Asignar socio</button>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="data-table stack-sm" id="tablaSocios">
                            <thead>
                                <tr>
                                    <th>Socio</th>
                                    <th>Membresía</th>
                                    <th>Última asistencia</th>
                                    <th>Objetivo principal</th>
                                    <th>Asignado</th>
                                    <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Socios)
                                {
                                    var ini = string.Concat(s.Nombre.Split(", ").Reverse().Select(p => p.FirstOrDefault())).ToUpperInvariant();
                                    var diasSinVenir = s.UltimaAsistencia.HasValue ? (hoy - s.UltimaAsistencia.Value.ToLocalTime().Date).Days : (int?)null;
                                    <tr data-search="@($"{s.Nombre} {s.Dni} {s.NumeroSocio} {s.Objetivo}")">
                                        <td class="cell-main" data-label="Socio">
                                            <div class="person-cell">
                                                <partial name="Components/_Avatar" model='new AvatarVm(null, ini, "sm")' />
                                                <div class="person-cell__copy">
                                                    <strong>@s.Nombre</strong>
                                                    <small>DNI @s.Dni · N° @(s.NumeroSocio ?? s.SocioId.ToString())</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Membresía">
                                            <span class="status-pill @s.MembresiaVariante">@s.Membresia</span>
                                            @if (s.PlanNombre is not null) { <div class="small text-muted mt-1">@s.PlanNombre</div> }
                                        </td>
                                        <td data-label="Última asistencia" class="num @(diasSinVenir > 14 ? "text-warning" : "text-soft")">
                                            @(s.UltimaAsistencia.HasValue ? Relativo(s.UltimaAsistencia.Value) : "Sin registros")
                                            @if (diasSinVenir > 14) { <i class="bi bi-exclamation-circle" title="Más de 2 semanas sin asistir"></i> }
                                        </td>
                                        <td data-label="Objetivo">@(s.Objetivo ?? "—")</td>
                                        <td data-label="Asignado" class="text-soft num hide-sm">@s.FechaAsignacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td class="cell-actions text-end">
                                            <div class="row-actions">
                                                <a class="icon-btn" asp-page="/Socios/Detalle" asp-route-id="@s.SocioId" title="Ver ficha del socio"><i class="bi bi-box-arrow-up-right"></i></a>
                                                @if (Usuario.Puede(Permisos.EntrenadoresEditar))
                                                {
                                                <button type="button" class="icon-btn danger" title="Quitar asignación"
                                                        data-confirm-action="@Url.Page("Detalle", "Desasignar", new { id = e.Id, asignacionId = s.AsignacionId })"
                                                        data-confirm-title="¿Quitar a @s.Nombre?"
                                                        data-confirm-text="El socio dejará de estar asignado a @e.NombreCompleto. Queda registrado en el historial."
                                                        data-confirm-label="Quitar asignación"
                                                        data-confirm-variant="warning">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr data-filter-empty hidden><td colspan="6" class="text-center text-muted py-4">Ningún socio coincide con el filtro.</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @* ---------- HISTORIAL ---------- *@
            <div class="tab-pane fade p-4" id="tab-historial" role="tabpanel">
                @if (Usuario.Puede(Permisos.EntrenadoresEditar))
                {
                <form method="post" asp-page-handler="Observacion" asp-route-id="@e.Id" class="d-flex gap-2 mb-4 flex-wrap">
                    <input name="texto" class="form-control flex-grow-1" style="min-width: 220px; flex-basis: 0" maxlength="2000" placeholder="Agregar una observación al historial…" required />
                    <button type="submit" class="secondary-btn"><i class="bi bi-chat-left-text"></i> Registrar</button>
                </form>
                }

                @if (Model.Historial.Count == 0)
                {
                    <p class="text-muted text-center py-4 mb-0">Todavía no hay movimientos registrados.</p>
                }
                else
                {
                    <ol class="timeline">
                        @foreach (var grupo in Model.Historial.GroupBy(h => new DateTime(h.Fecha.ToLocalTime().Year, h.Fecha.ToLocalTime().Month, 1)))
                        {
                            <li class="timeline-group">@grupo.Key.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-AR"))</li>
                            @foreach (var ev in grupo)
                            {
                                var estilo = EntrenadorPresentacion.Estilo(ev.Tipo);
                                <li class="timeline-item">
                                    <span class="timeline-dot @estilo.Variante"><i class="bi @estilo.Icono"></i></span>
                                    <div class="timeline-body">
                                        <h5>@ev.Titulo</h5>
                                        <time datetime="@ev.Fecha.ToString("o")">@ev.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                                        @if (!string.IsNullOrEmpty(ev.Detalle)) { <p>@ev.Detalle</p> }
                                        @if (ev.Usuario is { } quien)
                                        {
                                            <span class="audit-user mt-1"><span class="avatar-circle sm">@UsuarioActual.InicialesDe(quien)</span> @quien</span>
                                        }
                                    </div>
                                </li>
                            }
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</section>

@* ============ MODAL ASIGNAR SOCIOS ============ *@
@if (e.Activo)
{
    <div class="modal fade" id="asignarModal" tabindex="-1" aria-labelledby="asignarModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <form method="post" asp-page-handler="Asignar" asp-route-id="@e.Id" class="modal-content" id="asignarForm">
                <div class="modal-header px-4">
                    <div>
                        <h5 class="modal-title" id="asignarModalTitle">Asignar socios</h5>
                        <small class="text-muted">a @e.NombreCompleto · podés seleccionar varios</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body px-4">
                    <label class="search-input w-100 mb-3" aria-label="Buscar socios">
                        <i class="bi bi-search"></i>
                        <input type="search" id="buscarSocio" placeholder="Nombre, DNI o número de socio" autocomplete="off" />
                        <span class="spinner-border spinner-border-sm text-primary" id="buscarSpinner" hidden></span>
                    </label>
                    <div class="selected-tray mb-2" id="seleccionados"></div>
                    <ul class="pick-list" id="resultadosSocios" aria-live="polite">
                        <li class="text-muted small text-center py-4">Escribí al menos 2 caracteres para buscar.</li>
                    </ul>
                    <div class="mt-3">
                        <label for="objetivo" class="form-label small fw-semibold">Objetivo principal <span class="text-muted fw-normal">(opcional, se aplica a todos los seleccionados)</span></label>
                        <input id="objetivo" name="objetivo" class="form-control" maxlength="200" list="objetivosSugeridos" placeholder="Ej.: Hipertrofia, bajar de peso, rehabilitación de rodilla…" />
                        <datalist id="objetivosSugeridos">
                            <option value="Bajar de peso"></option>
                            <option value="Hipertrofia"></option>
                            <option value="Tonificación"></option>
                            <option value="Fuerza"></option>
                            <option value="Resistencia"></option>
                            <option value="Rehabilitación"></option>
                            <option value="Preparación deportiva"></option>
                            <option value="Salud general"></option>
                        </datalist>
                    </div>
                    <div id="idsSeleccionados"></div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="primary-btn border-0" id="btnAsignar" disabled><i class="bi bi-person-check"></i> Asignar <span id="cantSel"></span></button>
                </div>
            </form>
        </div>
    </div>
}

<partial name="Components/_ConfirmModal" />

@section Scripts {
    @if (e.Activo)
    {
        <script>
            (function () {
                const url = '@Html.Raw(Url.Page("Detalle", "BuscarSocios", new { id = e.Id }))';
                const input = document.getElementById('buscarSocio');
                const lista = document.getElementById('resultadosSocios');
                const spinner = document.getElementById('buscarSpinner');
                const tray = document.getElementById('seleccionados');
                const hidden = document.getElementById('idsSeleccionados');
                const btn = document.getElementById('btnAsignar');
                const cant = document.getElementById('cantSel');
                const seleccion = new Map(); // id -> nombre
                let timer, ultimo = [];

                const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
                const mensaje = (txt) => { lista.innerHTML = '<li class="text-muted small text-center py-4">' + esc(txt) + '</li>'; };

                function sincronizar() {
                    tray.innerHTML = '';
                    hidden.innerHTML = '';
                    seleccion.forEach((nombre, id) => {
                        tray.insertAdjacentHTML('beforeend',
                            '<span class="chip">' + esc(nombre) + ' <button type="button" data-quitar="' + id + '" aria-label="Quitar"><i class="bi bi-x"></i></button></span>');
                        hidden.insertAdjacentHTML('beforeend', '<input type="hidden" name="socioIds" value="' + id + '">');
                    });
                    btn.disabled = seleccion.size === 0;
                    cant.textContent = seleccion.size ? '(' + seleccion.size + ')' : '';
                    render(ultimo);
                }

                function render(items) {
                    ultimo = items;
                    if (!items.length) { if (input.value.trim().length >= 2) mensaje('No se encontraron socios.'); return; }
                    lista.innerHTML = items.map((s) => {
                        const sel = seleccion.has(s.id);
                        return '<li class="pick-item' + (s.asignado ? ' disabled' : '') + (sel ? ' selected' : '') + '" data-id="' + s.id + '" data-nombre="' + esc(s.nombre) + '">' +
                            '<input class="form-check-input" type="checkbox" tabindex="-1" ' + (sel || s.asignado ? 'checked ' : '') + (s.asignado ? 'disabled' : '') + '>' +
                            '<span class="avatar-circle sm">' + esc(s.iniciales) + '</span>' +
                            '<span class="pick-item__copy"><strong>' + esc(s.nombre) + '</strong><small>DNI ' + esc(s.dni) + ' · N° ' + esc(s.numero) + '</small></span>' +
                            (s.asignado ? '<span class="status-pill info">Ya asignado</span>' : '<span class="status-pill ' + esc(s.variante) + '">' + esc(s.membresia) + '</span>') +
                            '</li>';
                    }).join('');
                }

                input.addEventListener('input', () => {
                    clearTimeout(timer);
                    const q = input.value.trim();
                    if (q.length < 2) { ultimo = []; mensaje('Escribí al menos 2 caracteres para buscar.'); return; }
                    timer = setTimeout(async () => {
                        spinner.hidden = false;
                        try {
                            const r = await fetch(url + '&q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } });
                            render(r.ok ? await r.json() : []);
                        } catch { mensaje('No se pudo buscar. Intentá de nuevo.'); }
                        finally { spinner.hidden = true; }
                    }, 250);
                });

                lista.addEventListener('click', (ev) => {
                    const li = ev.target.closest('.pick-item');
                    if (!li || li.classList.contains('disabled')) return;
                    const id = li.dataset.id;
                    seleccion.has(id) ? seleccion.delete(id) : seleccion.set(id, li.dataset.nombre);
                    sincronizar();
                });

                tray.addEventListener('click', (ev) => {
                    const b = ev.target.closest('[data-quitar]');
                    if (!b) return;
                    seleccion.delete(b.dataset.quitar);
                    sincronizar();
                });

                document.getElementById('asignarModal').addEventListener('shown.bs.modal', () => input.focus());
            })();
        </script>
    }
}
