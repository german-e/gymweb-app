@page
@using GymCore.Web.Reportes
@model GymCore.Web.Pages.Reportes.IngresosModel
@{
    ViewData["Title"] = "Análisis de ingresos";
    var r = Model.Reporte;
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    var mesesAnio = Enumerable.Range(1, 12).Select(m => Presentacion.Mes(new DateOnly(hoy.Year, m, 1)).Split(' ')[0]).ToList();
    var posiciones = new[] { "1°", "2°", "3°" };
}

<section class="page-shell viz-root">
    <div class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-bar-chart-line"></i> Inteligencia de negocio</span>
            <h2>Análisis de ingresos</h2>
            <p>¿Cuánto estoy facturando? Recaudación diaria, mensual y anual, con sus tendencias. Pagos anulados excluidos.</p>
        </div>
    </div>

    <partial name="_Nav" />
    <partial name="_FiltroPeriodo" model="Model.Periodo" />

    <div class="kpi-grid">
        <partial name="_KpiTile" model="r.Diaria" />
        <partial name="_KpiTile" model="r.Mes" />
        <partial name="_KpiTile" model="r.Anio" />
        <partial name="_KpiTile" model="r.PorSocio" />
    </div>

    @if (r.Total == 0)
    {
        <div class="data-card"><partial name="Components/_EmptyState" model='new EmptyStateVm("bi-cash-stack", "Sin cobros en el período", "Probá con un período más amplio o registrá pagos para ver el análisis.")' /></div>
    }
    else
    {
        <div class="panel-card viz-card">
            <div class="viz-card__head">
                <div><h3>Evolución mensual de la recaudación</h3><p>@Model.Periodo.Texto · total @MetricasNegocio.Dinero(r.Total)</p></div>
            </div>
            <partial name="_Viz" model='new VizVm("line", new { etiquetas = r.Meses.Select(m => Presentacion.Mes(m.Mes)), titulos = r.Meses.Select(m => Periodo.NombreMesLargo(m.Mes) + " " + m.Mes.Year + (m.Completo ? "" : " (parcial)")), formato = "dinero", series = new[] { new { nombre = "Recaudación", valores = r.Meses.Select(m => (decimal?)m.Total), slot = "1" } } }, "Recaudación mensual del período")' />
        </div>

        <div class="dashboard-grid">
            <div class="panel-card viz-card">
                <div class="viz-card__head">
                    <div><h3>Comparación anual</h3><p>Recaudación por mes, @hoy.Year contra @(hoy.Year - 1)</p></div>
                    <ul class="viz-legend">
                        <li><span class="viz-key linea" style="background: var(--series-1)"></span> @hoy.Year</li>
                        <li><span class="viz-key linea" style="background: var(--series-gris)"></span> @(hoy.Year - 1)</li>
                    </ul>
                </div>
                <partial name="_Viz" model='new VizVm("line", new { etiquetas = mesesAnio, formato = "dinero", series = new object[] { new { nombre = (hoy.Year - 1).ToString(), valores = r.AnioAnterior, slot = "gris" }, new { nombre = hoy.Year.ToString(), valores = r.AnioActual, slot = "1" } } }, "Recaudación mensual del año actual comparada con el anterior")' />
            </div>
            <div class="panel-card viz-card">
                <div class="viz-card__head">
                    <div><h3>Recaudación diaria</h3><p>Últimos 30 días hasta el @Model.Periodo.Hasta.ToString("dd/MM")</p></div>
                </div>
                <partial name="_Viz" model='new VizVm("bars", new { etiquetas = r.Diario.Select(d => d.Dia.ToString("dd/MM")), formato = "dinero", series = new[] { new { nombre = "Recaudación", valores = r.Diario.Select(d => (decimal?)d.Total), slot = "1" } } }, "Recaudación de cada uno de los últimos 30 días")' />
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-trophy text-primary"></i> Mejores meses del período</h3></div>
                <ol class="podium">
                    @for (var i = 0; i < r.TopMeses.Count; i++)
                    {
                        var m = r.TopMeses[i];
                        <li class="podium__item pos-@(i + 1)">
                            <span class="podium__pos">@posiciones[i]</span>
                            <div class="min-w-0"><strong>@Periodo.NombreMesLargo(m.Mes) @m.Mes.Year</strong><small>@m.Pagos pagos@(m.Completo ? "" : " · mes en curso")</small></div>
                            <span class="podium__valor">@MetricasNegocio.Dinero(m.Total)</span>
                        </li>
                    }
                </ol>
            </div>
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-arrow-down-circle text-primary"></i> Mes de menor facturación</h3></div>
                @if (r.PeorMes is { } peor)
                {
                    <div class="worst-month">
                        <strong>@Periodo.NombreMesLargo(peor.Mes) @peor.Mes.Year</strong>
                        <span class="worst-month__valor">@MetricasNegocio.Dinero(peor.Total)</span>
                        <small>@peor.Pagos pagos · @(r.Meses.Where(m => m.Completo).Average(m => m.Total) is var prom && prom > 0 ? $"{Math.Round((peor.Total - prom) * 100 / prom):0}% respecto del promedio de los meses completos" : "")</small>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">El período no tiene meses completos todavía.</p>
                }
            </div>
        </div>

        <div class="data-card">
            <div class="toolbar"><strong>Datos por mes</strong><span class="small text-muted">Equivalente en tabla de los gráficos</span></div>
            <div class="table-responsive">
                <table class="data-table viz-data">
                    <thead><tr><th>Mes</th><th class="text-end">Recaudación</th><th class="text-end">Pagos</th><th class="text-end">Socios activos al cierre</th><th class="text-end">Ingreso por socio</th></tr></thead>
                    <tbody>
                        @foreach (var m in r.Meses)
                        {
                            <tr>
                                <td>@Periodo.NombreMesLargo(m.Mes) @m.Mes.Year @if (!m.Completo) { <span class="badge-light ms-1">parcial</span> }</td>
                                <td class="text-end num fw-semibold">@MetricasNegocio.Dinero(m.Total)</td>
                                <td class="text-end num">@m.Pagos</td>
                                <td class="text-end num">@m.Activos</td>
                                <td class="text-end num">@(m.PorSocio is { } ps ? MetricasNegocio.Dinero(ps) : "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th>Total</th><th class="text-end">@MetricasNegocio.Dinero(r.Total)</th><th class="text-end">@r.Meses.Sum(m => m.Pagos)</th><th></th><th></th></tr></tfoot>
                </table>
            </div>
            <details class="viz-table">
                <summary>Ver comparación anual en tabla</summary>
                <table class="data-table viz-data">
                    <thead><tr><th>Mes</th><th class="text-end">@(hoy.Year - 1)</th><th class="text-end">@hoy.Year</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < 12; i++)
                        {
                            <tr><td>@mesesAnio[i]</td><td class="text-end num">@(r.AnioAnterior[i] is { } a ? MetricasNegocio.Dinero(a) : "—")</td><td class="text-end num">@(r.AnioActual[i] is { } b ? MetricasNegocio.Dinero(b) : "—")</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
