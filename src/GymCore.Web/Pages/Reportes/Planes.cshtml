@page
@using GymCore.Web.Reportes
@model GymCore.Web.Pages.Reportes.PlanesModel
@{
    ViewData["Title"] = "Rendimiento de planes";
    var r = Model.Reporte;
    var top = r.Filas.Where(f => f.Ventas > 0).Take(3).ToList();
    var posiciones = new[] { "1°", "2°", "3°" };
}

<section class="page-shell viz-root">
    <div class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-bar-chart-line"></i> Inteligencia de negocio</span>
            <h2>Rendimiento de planes</h2>
            <p>¿Cuál es mi plan más vendido? Ventas, ingresos y socios por plan.</p>
        </div>
    </div>

    <partial name="_Nav" />
    <partial name="_FiltroPeriodo" model="Model.Periodo" />

    <div class="summary-grid">
        <div class="summary-card" data-bs-toggle="tooltip" title="Más suscripciones iniciadas en el período (altas y renovaciones)">
            <div class="module-icon success"><i class="bi bi-trophy"></i></div>
            <div class="min-w-0"><p>Plan más vendido</p><h4 class="text-truncate">@(r.MasVendido?.Plan.Nombre ?? "—")</h4><small class="text-muted">@(r.MasVendido is { } mv ? $"{mv.Ventas} ventas" : "sin ventas en el período")</small></div>
        </div>
        <div class="summary-card" data-bs-toggle="tooltip" title="Plan activo con menos suscripciones iniciadas en el período">
            <div class="module-icon warning"><i class="bi bi-arrow-down-circle"></i></div>
            <div class="min-w-0"><p>Plan menos vendido</p><h4 class="text-truncate">@(r.MenosVendido?.Plan.Nombre ?? "—")</h4><small class="text-muted">@(r.MenosVendido is { } mn ? $"{mn.Ventas} ventas" : "")</small></div>
        </div>
        <div class="summary-card" data-bs-toggle="tooltip" title="Pagos del período imputados a suscripciones de cada plan (sin pagos a cuenta ni anulados)">
            <div class="module-icon primary"><i class="bi bi-cash-stack"></i></div>
            <div><p>Ingreso generado por planes</p><h4>@MetricasNegocio.Dinero(r.Ingreso)</h4></div>
        </div>
        <div class="summary-card">
            <div class="module-icon info"><i class="bi bi-people"></i></div>
            <div><p>Socios activos con plan</p><h4>@r.ActivosConPlan</h4></div>
        </div>
    </div>

    @if (r.Filas.Count == 0)
    {
        <div class="data-card"><partial name="Components/_EmptyState" model='new EmptyStateVm("bi-box-seam", "Todavía no hay planes", "Creá planes para ver su rendimiento.")' /></div>
    }
    else
    {
        <div class="dashboard-grid">
            <div class="panel-card">
                <div class="panel-head mb-3"><h3><i class="bi bi-trophy text-primary"></i> Ranking de ventas</h3><span class="badge-light">@Model.Periodo.Texto</span></div>
                @if (top.Count == 0)
                {
                    <p class="text-muted mb-0">No hubo contrataciones en el período.</p>
                }
                else
                {
                    <ol class="podium">
                        @for (var i = 0; i < top.Count; i++)
                        {
                            var f = top[i];
                            <li class="podium__item pos-@(i + 1)">
                                <span class="podium__pos">@posiciones[i]</span>
                                <div class="min-w-0"><a class="fw-semibold" asp-page="/Planes/Detalle" asp-route-id="@f.Plan.Id">@f.Plan.Nombre</a><small>@f.Ventas ventas · @f.Renovaciones renovaciones · @f.SociosActivos socios activos</small></div>
                                <span class="podium__valor">@MetricasNegocio.Dinero(f.Ingreso)</span>
                            </li>
                        }
                    </ol>
                }
            </div>
            <div class="panel-card viz-card">
                <div class="viz-card__head"><div><h3>Socios activos por plan</h3><p>Participación hoy · @r.ActivosConPlan socios</p></div></div>
                @if (Model.Distribucion.Count == 0)
                {
                    <p class="text-muted mb-0">No hay socios activos.</p>
                }
                else
                {
                    <div class="donut-layout">
                        <partial name="_Viz" model='new VizVm("donut", new { formato = "numero", centro = r.ActivosConPlan.ToString(), centroDetalle = "socios", segmentos = Model.Distribucion.Select(d => new { nombre = d.Nombre, valor = d.Socios, slot = d.Slot }) }, "Distribución de socios activos por plan", 200, Cuadrado: true)' />
                        <ul class="viz-legend vertical">
                            @foreach (var d in Model.Distribucion)
                            {
                                <li><span class="viz-key caja" style="background: var(--series-@d.Slot)"></span> <span class="text-truncate">@d.Nombre</span> <strong class="ms-auto num">@d.Socios</strong> <small class="text-soft num">@d.Pct.ToString("0.#", Periodo.Es)%</small></li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="panel-card">
                <div class="panel-head mb-3"><h3>Ventas por plan</h3><span class="small text-muted">Suscripciones iniciadas</span></div>
                <partial name="_BarrasH" model='new BarrasHVm(r.Filas.Select(f => new BarraH(f.Plan.Nombre, f.Ventas, f.Ventas.ToString(), f.Plan.Activo ? null : "inactivo", Url.Page("/Planes/Detalle", new { id = f.Plan.Id }))).ToList(), "Ventas por plan")' />
            </div>
            <div class="panel-card">
                <div class="panel-head mb-3"><h3>Ingreso generado por plan</h3><span class="small text-muted">@Model.Periodo.Texto</span></div>
                <partial name="_BarrasH" model='new BarrasHVm(r.Filas.OrderByDescending(f => f.Ingreso).Select(f => new BarraH(f.Plan.Nombre, f.Ingreso, MetricasNegocio.Dinero(f.Ingreso), null, Url.Page("/Planes/Detalle", new { id = f.Plan.Id }))).ToList(), "Ingreso por plan")' />
            </div>
        </div>

        <div class="data-card">
            <div class="toolbar"><strong>Detalle por plan</strong><span class="small text-muted">Equivalente en tabla de los gráficos</span></div>
            <div class="table-responsive">
                <table class="data-table viz-data" data-sortable>
                    <thead><tr><th data-sort="text">Plan</th><th>Estado</th><th data-sort="num" class="text-end">Ventas</th><th data-sort="num" class="text-end">Renovaciones</th><th data-sort="num" class="text-end">Socios activos</th><th data-sort="num" class="text-end">Participación</th><th data-sort="num" class="text-end">Ingreso</th></tr></thead>
                    <tbody>
                        @foreach (var f in r.Filas)
                        {
                            <tr>
                                <td><a asp-page="/Planes/Detalle" asp-route-id="@f.Plan.Id">@f.Plan.Nombre</a></td>
                                <td><span class="status-pill @(f.Plan.Activo ? "success" : "muted")">@(f.Plan.Activo ? "Activo" : "Inactivo")</span></td>
                                <td class="text-end num">@f.Ventas</td>
                                <td class="text-end num">@f.Renovaciones</td>
                                <td class="text-end num">@f.SociosActivos</td>
                                <td class="text-end num" data-sort-value="@f.Participacion.ToString(System.Globalization.CultureInfo.InvariantCulture)">@f.Participacion.ToString("0.#", Periodo.Es)%</td>
                                <td class="text-end num fw-semibold" data-sort-value="@f.Ingreso.ToString(System.Globalization.CultureInfo.InvariantCulture)">@MetricasNegocio.Dinero(f.Ingreso)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
