@page "/panel"
@model GymCore.Web.Pages.PanelModel
@{
    ViewData["Title"] = "Panel de gestión";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <span class="eyebrow"><i class="bi bi-graph-up-arrow"></i> Gestión general</span>
            <h2>Panel de gestión</h2>
            <p>Accedé rápido a los indicadores clave, alertas y acciones frecuentes del gimnasio.</p>
        </div>

        <div class="header-actions">
            <a class="primary-btn" asp-page="/Socios/Socios"><i class="bi bi-person-plus"></i> Agregar socio</a>
            <a class="secondary-btn" asp-page="/Pagos/Index"><i class="bi bi-wallet2"></i> Registrar pago</a>
        </div>
    </div>

    <div class="stats-grid">
        <article class="stat-card primary">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-copy">
                <p>Socios activos</p>
                <h3>@Model.SociosActivos</h3>
            </div>
            <span class="trend positive">+12.4%</span>
        </article>

        <article class="stat-card warning">
            <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="stat-copy">
                <p>Cuotas vencidas</p>
                <h3>@Model.SuscripcionesVencidas</h3>
            </div>
            <span class="trend negative">-2.1%</span>
        </article>

        <article class="stat-card success">
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="stat-copy">
                <p>Ingresos del mes</p>
                <h3>$@Model.IngresosDelMes</h3>
            </div>
            <span class="trend positive">+8.7%</span>
        </article>

        <article class="stat-card danger">
            <div class="stat-icon"><i class="bi bi-geo-alt"></i></div>
            <div class="stat-copy">
                <p>Asistencias hoy</p>
                <h3>@Model.AsistenciasHoy</h3>
            </div>
            <span class="trend positive">+5.0%</span>
        </article>
    </div>

    <div class="shortcuts-row">
        <a class="shortcut-pill" asp-page="/Socios/Socios"><i class="bi bi-person-plus"></i> Nuevo socio</a>
        <a class="shortcut-pill" asp-page="/Asistencias/Ingreso"><i class="bi bi-door-open"></i> Control de ingreso</a>
        <a class="shortcut-pill" asp-page="/Pagos/Index"><i class="bi bi-receipt"></i> Últimos pagos</a>
        <a class="shortcut-pill" asp-page="/Planes/Planes"><i class="bi bi-card-list"></i> Ver planes</a>
    </div>

    <div class="dashboard-grid">
        <div class="panel-card">
            <div class="panel-head">
                <h3>Evolución de socios</h3>
                <a class="muted-link" href="#">Ver detalle</a>
            </div>

            <div class="mini-chart" aria-label="Gráfico de evolución de socios">
                <div class="chart-bar" style="height: 38%;"><span>Ene</span></div>
                <div class="chart-bar" style="height: 48%;"><span>Feb</span></div>
                <div class="chart-bar" style="height: 55%;"><span>Mar</span></div>
                <div class="chart-bar" style="height: 62%;"><span>Abr</span></div>
                <div class="chart-bar" style="height: 70%;"><span>May</span></div>
                <div class="chart-bar" style="height: 82%;"><span>Jun</span></div>
                <div class="chart-bar" style="height: 90%;"><span>Jul</span></div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-head">
                <h3>Alertas importantes</h3>
                <a class="muted-link" href="#">Ver todo</a>
            </div>

            <ul class="alert-list">
                <li class="alert-item">
                    <div class="alert-guide">
                        <span class="status-bubble danger"></span>
                        <div class="alert-copy">
                            <h4>Cuota vencida</h4>
                            <p>3 socios requieren seguimiento hoy</p>
                        </div>
                    </div>
                    <span class="badge-soft danger">Urgente</span>
                </li>
                <li class="alert-item">
                    <div class="alert-guide">
                        <span class="status-bubble warning"></span>
                        <div class="alert-copy">
                            <h4>Inventario bajo</h4>
                            <p>Mat. para entrenamiento en stock crítico</p>
                        </div>
                    </div>
                    <span class="badge-soft warning">Aviso</span>
                </li>
                <li class="alert-item">
                    <div class="alert-guide">
                        <span class="status-bubble success"></span>
                        <div class="alert-copy">
                            <h4>Meta mensual</h4>
                            <p>Estás al 82% de tu objetivo de ingresos</p>
                        </div>
                    </div>
                    <span class="badge-soft success">OK</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="dashboard-grid" style="margin-top: 20px;">
        <div class="panel-card">
            <div class="panel-head">
                <h3>Próximos vencimientos</h3>
                <a class="muted-link" href="#">Agenda</a>
            </div>

            <ul class="list-rows">
                <li class="list-row">
                    <div class="list-copy">
                        <h4>María López</h4>
                        <p>Plan mensual • vence en 2 días</p>
                    </div>
                    <span class="list-value warning">Recordar</span>
                </li>
                <li class="list-row">
                    <div class="list-copy">
                        <h4>Diego Torres</h4>
                        <p>Plan trimestral • vence en 4 días</p>
                    </div>
                    <span class="list-value warning">Pendiente</span>
                </li>
                <li class="list-row">
                    <div class="list-copy">
                        <h4>Lucía Gómez</h4>
                        <p>Plan anual • vence en 7 días</p>
                    </div>
                    <span class="list-value success">Activo</span>
                </li>
            </ul>
        </div>

        <div class="panel-card">
            <div class="panel-head">
                <h3>Últimos pagos</h3>
                <a class="muted-link" href="#">Ver historial</a>
            </div>

            <ul class="payments-list">
                <li class="payment-row">
                    <div class="payment-copy">
                        <h4>Carla Ruiz</h4>
                        <p>Transferencia • 12 jul</p>
                    </div>
                    <span class="amount">$12.500</span>
                </li>
                <li class="payment-row">
                    <div class="payment-copy">
                        <h4>Agustín Díaz</h4>
                        <p>Tarjeta • 12 jul</p>
                    </div>
                    <span class="amount">$15.000</span>
                </li>
                <li class="payment-row">
                    <div class="payment-copy">
                        <h4>Paula Silva</h4>
                        <p>Efectivo • 11 jul</p>
                    </div>
                    <span class="amount">$8.300</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="module-section" style="margin-top: 24px;">
        <div class="section-heading">
            <h2>Módulos principales</h2>
            <a class="muted-link" href="#">Todos los módulos</a>
        </div>

        <div class="module-grid">
            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon primary"><i class="bi bi-people"></i></span>
                        <h3>Socios</h3>
                    </div>
                    <span class="badge-light">Gestión</span>
                </div>
                <p>Altas, fichas, seguimiento de membresías y estado de suscripciones.</p>
                <div class="module-actions">
                    <a class="btn btn-primary btn-sm" asp-page="/Socios/Socios">Abrir</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Nuevo</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon success"><i class="bi bi-box-seam"></i></span>
                        <h3>Planes</h3>
                    </div>
                    <span class="badge-light">Catálogo</span>
                </div>
                <p>Definición de planes, cuotas, beneficios y condiciones por membresía.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" asp-page="/Planes/Planes">Ver</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Crear</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon warning"><i class="bi bi-credit-card"></i></span>
                        <h3>Pagos</h3>
                    </div>
                    <span class="badge-light">Caja</span>
                </div>
                <p>Control de pagos, cuotas pendientes, historial y métodos de cobro.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" asp-page="/Pagos/Index">Historial</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Cobrar</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon info"><i class="bi bi-door-open"></i></span>
                        <h3>Asistencias</h3>
                    </div>
                    <span class="badge-light">Control</span>
                </div>
                <p>Acceso, registro de entradas y seguimiento de hábitos de cada socio.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" asp-page="/Asistencias/Ingreso">Ingresar</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Reporte</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon muted"><i class="bi bi-person-badge"></i></span>
                        <h3>Entrenadores</h3>
                    </div>
                    <span class="badge-light">Staff</span>
                </div>
                <p>Horarios, asignaciones y gestión del cuerpo técnico del club.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" href="#">Listar</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Nuevo</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon primary"><i class="bi bi-bar-chart"></i></span>
                        <h3>Reportes</h3>
                    </div>
                    <span class="badge-light">Análisis</span>
                </div>
                <p>Indicadores de finanzas, socios, asistencias y morosidad del negocio.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" href="#">Ver</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Exportar</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon danger"><i class="bi bi-box2-heart"></i></span>
                        <h3>Insumos</h3>
                    </div>
                    <span class="badge-light">Stock</span>
                </div>
                <p>Inventario de materiales, compras, stock mínimo y control de productos.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" href="#">Inventario</a>
                    <a class="btn btn-outline-secondary btn-sm" href="#">Compras</a>
                </div>
            </article>

            <article class="module-card">
                <div class="module-head">
                    <div class="module-title">
                        <span class="module-icon muted"><i class="bi bi-sliders"></i></span>
                        <h3>Configuración</h3>
                    </div>
                    <span class="badge-light">Sistema</span>
                </div>
                <p>Usuarios, permisos, parámetros generales y perfil del gimnasio.</p>
                <div class="module-actions">
                    <a class="btn btn-outline-primary btn-sm" href="#">Ajustes</a>
                </div>
            </article>
        </div>
    </div>
</section>
