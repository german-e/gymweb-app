@page "{id:int}"
@model GymCore.Web.Pages.Planes.EditModel
@{
    ViewData["Title"] = "Editar plan";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <a class="text-decoration-none small fw-semibold" asp-page="Detalle" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> @Model.Nombre</a>
            <h2>Editar plan</h2>
            <p>Actualizá los datos del plan. Las suscripciones existentes conservan sus fechas.</p>
        </div>
    </div>

    <partial name="_PlanForm" model="Model" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
