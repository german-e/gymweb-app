@page
@model GymCore.Web.Pages.Planes.PlanesModel
@{
    ViewData["Title"] = "Planes";
}

<section class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div>
            <h1 class="h4 mb-1">Planes</h1>
            <p class="text-muted mb-0">Catálogo de planes disponibles.</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-page="/Planes/Create">Nuevo plan</a>
        </div>
    </div>

    <div class="row g-3">
        @if (Model.Items.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">No hay planes cargados.</div>
            </div>
        }
        else
        {
            foreach (var p in Model.Items)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm module-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h3 class="h6 mb-0">@p.Nombre</h3>
                                    @if (Model.ActivosPorPlan.TryGetValue(p.Id, out var cant) && cant > 0)
                                    {
                                        <span class="badge text-bg-success mt-1">@cant activos</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary mt-1">0 activos</span>
                                    }
                                </div>
                                <span class="badge text-bg-light">@p.Tipo</span>
                            </div>
                            <p class="text-muted small mb-2">@p.Descripcion</p>
                            <div class="mb-2 fw-semibold">Precio: $ @p.Precio @p.Moneda</div>
                            <div class="text-muted small mb-3">Duración: @p.DuracionDias días</div>
                            @if (p.MaxDiasPorSemana.HasValue)
                            {
                                <div class="text-muted small">Tope semanal: @p.MaxDiasPorSemana x semana</div>
                            }
                            <div class="mt-auto d-flex gap-2 pt-3">
                                <a class="btn btn-sm btn-outline-success" asp-page="/Planes/Suscriptos" asp-route-planId="@p.Id">Ver socios</a>
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Planes/Edit" asp-route-id="@p.Id">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-page="/Planes/Delete" asp-route-id="@p.Id">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
