@page
@model GymCore.Web.Pages.Planes.CreateModel
@{
    ViewData["Title"] = "Nuevo plan";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <a class="text-decoration-none small fw-semibold" asp-page="Planes"><i class="bi bi-arrow-left"></i> Planes</a>
            <h2>@(Model.DuplicadoDe is null ? "Nuevo plan" : "Duplicar plan")</h2>
            <p>
                @if (Model.DuplicadoDe is not null)
                {
                    <text>Partís de una copia de <strong>@Model.DuplicadoDe</strong>. Ajustá lo que necesites y guardá.</text>
                }
                else
                {
                    <text>Definí precio, duración y reglas de acceso. Los campos con <span class="text-danger">*</span> son obligatorios.</text>
                }
            </p>
        </div>
    </div>

    <partial name="_PlanForm" model="Model" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
