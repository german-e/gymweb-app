@page "{id:int}"
@using GymCore.Web.Pages.Planes
@using GymCore.Web.Pages.Socios
@model GymCore.Web.Pages.Planes.DeleteModel
@{
    ViewData["Title"] = "Eliminar plan";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <a class="text-decoration-none small fw-semibold" asp-page="Detalle" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> @Model.Nombre</a>
            <h2>Eliminar plan</h2>
            <p>Esta acción no se puede deshacer.</p>
        </div>
    </div>

    <div class="data-card narrow-card">
        <div class="p-4 d-flex gap-3">
            <div class="module-icon danger"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="flex-grow-1">
                <h5 class="mb-3">¿Eliminar <strong>@Model.Nombre</strong>?</h5>
                <dl class="info-list">
                    <div><dt>Tipo</dt><dd>@Model.Tipo.Texto()</dd></div>
                    <div><dt>Precio</dt><dd>@SocioPresentacion.Dinero(Model.Precio, Model.Moneda)</dd></div>
                </dl>
                @if (Model.Suscripciones > 0)
                {
                    <div class="flash danger mt-3 mb-0">
                        <i class="bi bi-lock-fill"></i>
                        Tiene @Model.Suscripciones @(Model.Suscripciones == 1 ? "suscripción registrada" : "suscripciones registradas") y no puede eliminarse sin perder el historial de los socios.
                    </div>
                }
            </div>
        </div>
        <form method="post" class="form-actions-bar rounded-0 border-0 border-top" data-submit-loading>
            <input type="hidden" asp-for="Id" />
            <a asp-page="Detalle" asp-route-id="@Model.Id" class="secondary-btn">Cancelar</a>
            <button type="submit" class="btn btn-danger px-3" disabled="@(Model.Suscripciones > 0)" data-loading-text="Eliminando…"><i class="bi bi-trash"></i> Eliminar plan</button>
        </form>
    </div>
</section>
