@page
@model GymCore.Web.Pages.Planes.SuscriptosModel
@{
    ViewData["Title"] = "Socios suscriptos";
}

<section class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div>
            <h1 class="h5 mb-1">Socios suscriptos</h1>
            <p class="text-muted mb-0">Plan: <strong>@Model.Plan?.Nombre</strong></p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-page="/Planes/Planes">Volver a planes</a>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-center mb-3">
        <input type="hidden" name="planId" value="@Model.PlanId" />
        <div class="col-auto form-check">
            <input class="form-check-input" type="checkbox" id="soloActivos" name="soloActivos" value="true" @(Model.SoloActivos ? "checked" : null) onchange="this.form.submit()" />
            <label class="form-check-label" for="soloActivos">Ver solo activos</label>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">DNI</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Vence</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Socios.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay socios para mostrar</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Socios)
                        {
                            var s = item.Socio;
                            var sp = item.Suscripcion;
                            var badgeClass = sp.Estado == GymCore.Dominio.Enums.EstadoSuscripcion.Activo ? "success" : "warning";
                            <tr>
                                <td>@s.Dni</td>
                                <td>@s.Apellido</td>
                                <td>@s.Nombre</td>
                                <td>
                                    <span class="badge text-bg-@badgeClass">@sp.Estado</span>
                                </td>
                                <td>@sp.FechaFin.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
