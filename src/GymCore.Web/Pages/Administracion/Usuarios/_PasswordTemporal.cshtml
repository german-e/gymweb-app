@model string
@* Contraseña temporal recién generada: se muestra una única vez (TempData) con opción de copiar. *@
<div class="temp-password" role="status">
    <div class="module-icon warning"><i class="bi bi-key"></i></div>
    <div class="flex-grow-1 min-w-0">
        <strong>Contraseña temporal</strong>
        <small>Se muestra solo esta vez. El usuario deberá cambiarla al ingresar.</small>
    </div>
    <code class="temp-password__value">@Model</code>
    <button type="button" class="secondary-btn btn-compact" data-copy="@Model"><i class="bi bi-clipboard"></i> Copiar</button>
</div>
