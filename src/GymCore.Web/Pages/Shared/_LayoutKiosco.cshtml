@inject GymCore.Web.Marca.ServicioBranding Marca
@{
    var marca = await Marca.ActualAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <title>@ViewData["Title"] - @marca.Nombre</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <partial name="_Favicon" model="marca" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kiosco.css" asp-append-version="true" />
    <style id="marca-gimnasio">:root{@Html.Raw(marca.VariablesCss)}</style>
</head>
<body class="kiosco-body">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
