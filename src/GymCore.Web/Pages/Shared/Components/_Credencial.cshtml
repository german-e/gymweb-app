@model GymCore.Web.Componentes.CredencialVm
@inject GymCore.Web.Marca.ServicioBranding Marca
@{
    var marca = await Marca.ActualAsync();
    var gimnasio = marca.Nombre;
}
@* El código de barras se dibuja en el cliente (components.js → JsBarcode, CODE128) con el código del sistema. *@
<article class="credencial @Model.Variante @(Model.Mini ? "credencial-mini" : "")" id="@Model.Id" aria-label="Credencial de @Model.NombreCompleto">
    <div class="credencial__top">
        <span class="credencial__brand">
            @if (marca.Isotipo is { } iso)
            {
                <img class="credencial__logo" src="@iso" alt="" />
            }
            else
            {
                <i class="bi bi-lightning-charge-fill"></i>
            }
            <span class="credencial__brand-nombre">@gimnasio</span>
        </span>
        <span class="credencial__estado">@Model.EstadoTexto</span>
    </div>
    <div class="credencial__body">
        <span class="credencial__foto">
            @if (!string.IsNullOrEmpty(Model.FotoUrl))
            {
                <img src="@Url.Content("~/" + Model.FotoUrl)" alt="" />
            }
            else
            {
                @Model.Iniciales
            }
        </span>
        <div class="credencial__datos">
            <span class="credencial__nombre">@Model.NombreCompleto</span>
            <dl class="credencial__meta">
                <dt>Socio N°</dt><dd>@Model.NumeroSocio</dd>
                <dt>DNI</dt><dd>@Model.Dni</dd>
                @if (!Model.Mini)
                {
                    <dt>Plan</dt><dd>@(Model.Plan ?? "Sin plan")</dd>
                }
                <dt>Vence</dt><dd>@(Model.Vencimiento?.ToString("dd/MM/yyyy") ?? "—")</dd>
            </dl>
        </div>
    </div>
    <div class="credencial__codigo">
        <svg data-barcode="@Model.Codigo" role="img" aria-label="Código de barras @Model.Codigo"></svg>
    </div>
    @if (!Model.Mini)
    {
        <div class="credencial__pie">@marca.TextoCredencial@(string.IsNullOrEmpty(marca.Contacto) ? "" : " · " + marca.Contacto)</div>
    }
</article>
