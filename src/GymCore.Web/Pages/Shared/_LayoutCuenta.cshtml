@inject GymCore.Web.Marca.ServicioBranding Marca
@{
    var marca = await Marca.ActualAsync();
    var gimnasio = marca.Nombre;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @gimnasio</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="@marca.Primario.Hex" />
    <partial name="_Favicon" model="marca" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <style id="marca-gimnasio">:root{@Html.Raw(marca.VariablesCss)}</style>
</head>
<body class="auth-body @(marca.ImagenBienvenida is null ? "" : "has-imagen")">
    @if (marca.ImagenBienvenida is { } imagen)
    {
        @* Panel de bienvenida con la foto del gimnasio (solo pantallas anchas) *@
        <aside class="auth-hero" style="background-image: url('@imagen')" aria-hidden="true">
            <div class="auth-hero__copy">
                @if (marca.Logo is { } logoHero) { <img src="@logoHero" alt="" class="auth-hero__logo" /> }
                <strong>@gimnasio</strong>
                <span>@marca.Eslogan</span>
            </div>
        </aside>
    }
    <main class="auth-shell">
        <div class="auth-brand">
            @if (marca.Logo is { } logo)
            {
                <img src="@logo" alt="@gimnasio" class="auth-brand__logo" />
            }
            else
            {
                <partial name="_MarcaIsotipo" model="marca" />
                <div>
                    <strong>@gimnasio</strong>
                    <small>@marca.Eslogan</small>
                </div>
            }
        </div>

        @RenderBody()

        <p class="auth-foot">© @DateTime.Now.Year @gimnasio · Acceso exclusivo para personal autorizado</p>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>
    <script>
        // Mostrar / ocultar contraseña: <button data-toggle-password="#id">
        document.addEventListener('click', (e) => {
            const b = e.target.closest('[data-toggle-password]');
            if (!b) return;
            const input = document.querySelector(b.dataset.togglePassword);
            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            b.querySelector('i').className = 'bi ' + (visible ? 'bi-eye' : 'bi-eye-slash');
            b.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
