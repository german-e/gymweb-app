<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymCore.Web</title>
    <meta name="description" content="Sistema de gestión para gimnasios y clubes deportivos." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCore.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar" aria-label="Menú principal">
            <div class="sidebar-header">
                <div class="brand-mark">
                    <i class="bi bi-dumbbell"></i>
                </div>
                <div class="brand-copy">
                    <span class="brand-name">GymCore</span>
                    <small>Club Management</small>
                </div>
            </div>

            <nav class="sidebar-nav" aria-label="Navegación principal">
                <div class="nav-section">
                    <span class="nav-label">General</span>
                    <a class="nav-item active" asp-page="/Panel">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Panel</span>
                    </a>
                    <a class="nav-item" asp-page="/Index">
                        <i class="bi bi-house-door"></i>
                        <span>Inicio</span>
                    </a>
                </div>

                <div class="nav-section">
                    <span class="nav-label">Operación</span>
                    <a class="nav-item" asp-page="/Socios/Socios">
                        <i class="bi bi-people"></i>
                        <span>Socios</span>
                    </a>
                    <a class="nav-item" href="#">
                        <i class="bi bi-person-badge"></i>
                        <span>Entrenadores</span>
                    </a>
                    <a class="nav-item" asp-page="/Planes/Planes">
                        <i class="bi bi-box-seam"></i>
                        <span>Planes</span>
                    </a>
                    <a class="nav-item" href="#">
                        <i class="bi bi-box2-heart"></i>
                        <span>Insumos</span>
                    </a>
                    <a class="nav-item" asp-page="/Pagos/Index">
                        <i class="bi bi-credit-card"></i>
                        <span>Pagos</span>
                    </a>
                    <a class="nav-item" href="#">
                        <i class="bi bi-bar-chart"></i>
                        <span>Reportes</span>
                    </a>
                    <a class="nav-item" href="#">
                        <i class="bi bi-sliders"></i>
                        <span>Configuración</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="mini-card">
                    <span class="mini-card__label">Cobranza</span>
                    <strong>$18.400</strong>
                    <small>Este mes</small>
                </div>
            </div>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Alternar menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <p class="topbar-kicker">Gestión del gimnasio</p>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="topbar-actions">
                    <label class="global-search" aria-label="Buscar en el sistema">
                        <i class="bi bi-search"></i>
                        <input type="search" placeholder="Buscar socios, pagos, planes..." />
                    </label>

                    <button class="icon-button" type="button" aria-label="Notificaciones">
                        <i class="bi bi-bell"></i>
                        <span class="badge-dot">3</span>
                    </button>

                    <div class="user-menu" aria-label="Perfil del usuario">
                        <div class="avatar">GP</div>
                        <div class="user-meta">
                            <strong>Germán</strong>
                            <small>Admin</small>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </header>

            <main class="content-panel" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.querySelector('[data-sidebar-toggle]');
            if (!toggle) return;

            toggle.addEventListener('click', function () {
                document.body.classList.toggle('sidebar-open');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>