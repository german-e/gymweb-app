@inject GymCore.Web.Componentes.IUsuarioActual Usuario
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymCore.Web</title>
    <meta name="description" content="Sistema de gestión para gimnasios y clubes deportivos." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCore.Web.styles.css" asp-append-version="true" />
</head>
@{
    // Resalta el módulo actual en el menú lateral
    var pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Activo(params string[] prefijos) => prefijos.Any(x => pagina.StartsWith(x, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar" aria-label="Menú principal">
            <div class="sidebar-header">
                <div class="brand-mark">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div class="brand-copy">
                    <span class="brand-name">GymCore</span>
                    <small>Club Management</small>
                </div>
            </div>

            @* Menú según permisos: lo que el usuario no puede usar no se muestra *@
            <nav class="sidebar-nav" aria-label="Navegación principal">
                <div class="nav-section">
                    <span class="nav-label">General</span>
                    <a class="nav-item @Activo("/Panel")" asp-page="/Panel">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Panel</span>
                    </a>
                    <a class="nav-item @Activo("/Index")" asp-page="/Index">
                        <i class="bi bi-house-door"></i>
                        <span>Inicio</span>
                    </a>
                </div>

                <div class="nav-section">
                    <span class="nav-label">Operación</span>
                    @if (Usuario.PuedeAlguno(Permisos.SociosVer, Permisos.SociosVerAsignados))
                    {
                        <a class="nav-item @Activo("/Socios", "/Suscripciones")" asp-page="/Socios/Socios">
                            <i class="bi bi-people"></i>
                            <span>@(Usuario.Puede(Permisos.SociosVer) ? "Socios" : "Mis socios")</span>
                        </a>
                    }
                    @if (Usuario.Puede(Permisos.AsistenciasRegistrar))
                    {
                        <a class="nav-item @Activo("/Asistencias")" asp-page="/Asistencias/Ingreso">
                            <i class="bi bi-door-open"></i>
                            <span>Control de ingreso</span>
                        </a>
                    }
                    @if (Usuario.Puede(Permisos.EntrenadoresVer))
                    {
                        <a class="nav-item @Activo("/Entrenadores")" asp-page="/Entrenadores/Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Entrenadores</span>
                        </a>
                    }
                    @if (Usuario.Puede(Permisos.PlanesVer))
                    {
                        <a class="nav-item @Activo("/Planes")" asp-page="/Planes/Planes">
                            <i class="bi bi-box-seam"></i>
                            <span>Planes</span>
                        </a>
                    }
                    @if (Usuario.Puede(Permisos.PagosVer))
                    {
                        <a class="nav-item @Activo("/Pagos")" asp-page="/Pagos/Index">
                            <i class="bi bi-credit-card"></i>
                            <span>Pagos</span>
                        </a>
                    }
                </div>

                @if (Usuario.PuedeAlguno(Permisos.VentasCrear, Permisos.VentasVer, Permisos.ProductosVer, Permisos.InventarioAdministrar, Permisos.ReportesComercialesVer))
                {
                    <div class="nav-section">
                        <span class="nav-label">Ventas</span>
                        @if (Usuario.Puede(Permisos.VentasCrear))
                        {
                            <a class="nav-item @Activo("/Ventas/Pos")" asp-page="/Ventas/Pos"><i class="bi bi-cart3"></i><span>Punto de Venta</span></a>
                        }
                        @if (Usuario.Puede(Permisos.VentasVer))
                        {
                            <a class="nav-item @(pagina is "/Ventas/Index" or "/Ventas/Ticket" ? "active" : "")" asp-page="/Ventas/Index"><i class="bi bi-receipt"></i><span>Ventas</span></a>
                        }
                        @if (Usuario.Puede(Permisos.ProductosVer))
                        {
                            <a class="nav-item @Activo("/Ventas/Productos")" asp-page="/Ventas/Productos/Index"><i class="bi bi-box2"></i><span>Productos</span></a>
                            <a class="nav-item @Activo("/Ventas/Categorias")" asp-page="/Ventas/Categorias"><i class="bi bi-tags"></i><span>Categorías</span></a>
                            <a class="nav-item @Activo("/Ventas/Inventario")" asp-page="/Ventas/Inventario"><i class="bi bi-clipboard-data"></i><span>Inventario</span></a>
                        }
                        @if (Usuario.Puede(Permisos.InventarioAdministrar))
                        {
                            <a class="nav-item @Activo("/Ventas/Movimientos")" asp-page="/Ventas/Movimientos"><i class="bi bi-arrow-left-right"></i><span>Movimientos</span></a>
                        }
                        @if (Usuario.Puede(Permisos.ReportesComercialesVer))
                        {
                            <a class="nav-item @Activo("/Ventas/Reportes")" asp-page="/Ventas/Reportes"><i class="bi bi-graph-up-arrow"></i><span>Reportes comerciales</span></a>
                        }
                    </div>
                }

                @if (Usuario.Puede(Permisos.ReportesVer))
                {
                    <div class="nav-section">
                        <span class="nav-label">Inteligencia de negocio</span>
                        <a class="nav-item @(pagina == "/Reportes/Index" ? "active" : "")" asp-page="/Reportes/Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Resumen ejecutivo</span>
                        </a>
                        <a class="nav-item @Activo("/Reportes/Socios")" asp-page="/Reportes/Socios"><i class="bi bi-graph-up"></i><span>Socios</span></a>
                        <a class="nav-item @Activo("/Reportes/Ingresos")" asp-page="/Reportes/Ingresos"><i class="bi bi-cash-stack"></i><span>Ingresos</span></a>
                        <a class="nav-item @Activo("/Reportes/Planes")" asp-page="/Reportes/Planes"><i class="bi bi-pie-chart"></i><span>Planes</span></a>
                        <a class="nav-item @Activo("/Reportes/Entrenadores")" asp-page="/Reportes/Entrenadores"><i class="bi bi-person-lines-fill"></i><span>Entrenadores</span></a>
                        <a class="nav-item @Activo("/Reportes/Riesgo")" asp-page="/Reportes/Riesgo"><i class="bi bi-exclamation-octagon"></i><span>Riesgo de abandono</span></a>
                        @if (Usuario.Puede(Permisos.ReportesExportar))
                        {
                            <a class="nav-item @Activo("/Reportes/Exportaciones", "/Reportes/Imprimir")" asp-page="/Reportes/Exportaciones"><i class="bi bi-download"></i><span>Exportaciones</span></a>
                        }
                    </div>
                }

                @if (Usuario.PuedeAlguno(Permisos.UsuariosAdministrar, Permisos.AuditoriaVer, Permisos.ConfiguracionAdministrar))
                {
                    <div class="nav-section">
                        <span class="nav-label">Administración</span>
                        @if (Usuario.Puede(Permisos.UsuariosAdministrar))
                        {
                            <a class="nav-item @Activo("/Administracion/Usuarios")" asp-page="/Administracion/Usuarios/Index">
                                <i class="bi bi-person-gear"></i>
                                <span>Usuarios</span>
                            </a>
                            <a class="nav-item @Activo("/Administracion/Roles")" asp-page="/Administracion/Roles/Index">
                                <i class="bi bi-shield-lock"></i>
                                <span>Roles y permisos</span>
                            </a>
                        }
                        @if (Usuario.Puede(Permisos.AuditoriaVer))
                        {
                            <a class="nav-item @Activo("/Administracion/Auditoria")" asp-page="/Administracion/Auditoria">
                                <i class="bi bi-shield-check"></i>
                                <span>Auditoría</span>
                            </a>
                        }
                        @if (Usuario.Puede(Permisos.ConfiguracionAdministrar))
                        {
                            <a class="nav-item" href="#" aria-disabled="true">
                                <i class="bi bi-sliders"></i>
                                <span>Configuración</span>
                                <span class="soon-badge ms-auto">Pronto</span>
                            </a>
                        }
                    </div>
                }
            </nav>

            @if (Usuario.Puede(Permisos.PagosVer))
            {
                <div class="sidebar-footer">
                    @await Component.InvokeAsync("SidebarMetricas", new { vista = "Sidebar" })
                </div>
            }
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Alternar menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <p class="topbar-kicker">Gestión del gimnasio</p>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="topbar-actions">
                    <label class="global-search" aria-label="Buscar en el sistema">
                        <i class="bi bi-search"></i>
                        <input type="search" placeholder="Buscar socios, pagos, planes..." />
                    </label>

                    @await Component.InvokeAsync("SidebarMetricas", new { vista = "Alertas" })

                    @* Menú de perfil *@
                    <div class="dropdown">
                        <button class="user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de @Usuario.Nombre">
                            <div class="avatar">@Usuario.Iniciales</div>
                            <div class="user-meta">
                                <strong>@Usuario.Nombre</strong>
                                <small>@Usuario.Rol</small>
                            </div>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end profile-menu">
                            <div class="profile-menu__head">
                                <span class="avatar-circle">@Usuario.Iniciales</span>
                                <div class="min-w-0">
                                    <strong>@Usuario.Nombre</strong>
                                    <small>@@@Usuario.NombreUsuario · @Usuario.Rol</small>
                                    <small class="text-soft"><i class="bi bi-clock-history"></i> Último acceso: @(Usuario.AccesoAnterior is { } previo ? previo.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "primer ingreso")</small>
                                </div>
                            </div>
                            <a class="dropdown-item" asp-page="/Cuenta/Perfil"><i class="bi bi-person"></i> Mi perfil</a>
                            <a class="dropdown-item" asp-page="/Cuenta/CambiarPassword"><i class="bi bi-key"></i> Cambiar contraseña</a>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-page="/Cuenta/Logout">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content-panel" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.querySelector('[data-sidebar-toggle]');
            if (!toggle) return;

            toggle.addEventListener('click', function () {
                document.body.classList.toggle('sidebar-open');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>