@inject GymCore.Web.Componentes.IUsuarioActual Usuario
@inject GymCore.Web.Marca.ServicioBranding Marca
@{
    var marca = await Marca.ActualAsync();
    var pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var menu = GymCore.Web.Componentes.Navegacion.Para(Usuario);
    // Con pocos ítems (ej. entrenador) todos los grupos arrancan abiertos; si no, solo el de la pantalla actual
    var todoAbierto = menu.Grupos.Sum(g => g.Items.Count) <= 8;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @marca.Nombre</title>
    <meta name="description" content="Sistema de gestión de @marca.Nombre." />
    <meta name="theme-color" content="@marca.Primario.Hex" />
    <partial name="_Favicon" model="marca" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymCore.Web.styles.css" asp-append-version="true" />
    @* Paleta del gimnasio (colores validados y ajustados para contraste en ServicioBranding) *@
    <style id="marca-gimnasio">:root{@Html.Raw(marca.VariablesCss)}</style>
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar" aria-label="Menú principal">
            <a class="sidebar-header" asp-page="/Panel" aria-label="@marca.Nombre: ir al panel">
                <partial name="_MarcaIsotipo" model="marca" />
                <span class="brand-copy">
                    <span class="brand-name">@marca.Nombre</span>
                    <small>@marca.Eslogan</small>
                </span>
            </a>

            @* Navegación según permisos: lo que el usuario no puede usar no se muestra *@
            <nav class="sidebar-nav" aria-label="Navegación principal" data-sidebar-nav data-nav-todo-abierto="@(todoAbierto ? "1" : "0")">
                <a class="nav-item nav-item--top @(menu.Inicio.EsActivo(pagina) ? "active" : "")" asp-page="@menu.Inicio.Pagina"
                   aria-current="@(menu.Inicio.EsActivo(pagina) ? "page" : null)">
                    <i class="bi @menu.Inicio.Icono" aria-hidden="true"></i><span>@menu.Inicio.Texto</span>
                </a>
                @foreach (var g in menu.Grupos)
                {
                    var activo = g.Contiene(pagina);
                    var abierto = activo || todoAbierto;
                    <div class="nav-group @(abierto ? "is-open" : "") @(activo ? "has-active" : "")" data-nav-group="@g.Clave">
                        <button type="button" class="nav-group__toggle" aria-expanded="@(abierto ? "true" : "false")" aria-controls="nav-@g.Clave">
                            <i class="bi @g.Icono" aria-hidden="true"></i>
                            <span class="nav-group__label">@g.Texto</span>
                            <span class="nav-group__count" aria-hidden="true">@g.Items.Count</span>
                            <i class="bi bi-chevron-down nav-group__chevron" aria-hidden="true"></i>
                        </button>
                        <div class="nav-group__items" id="nav-@g.Clave" role="group" aria-label="@g.Texto">
                            @foreach (var it in g.Items)
                            {
                                var esActivo = it.EsActivo(pagina);
                                <a class="nav-item @(esActivo ? "active" : "")" asp-page="@it.Pagina" aria-current="@(esActivo ? "page" : null)"
                                   target="@(it.Externo ? "_blank" : null)">
                                    <i class="bi @it.Icono" aria-hidden="true"></i><span>@it.Texto</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (Usuario.Puede(Permisos.PagosVer))
                {
                    <div class="sidebar-metricas">
                        @await Component.InvokeAsync("SidebarMetricas", new { vista = "Sidebar" })
                    </div>
                }
            </nav>

            @* Usuario actual: siempre visible *@
            <div class="sidebar-user">
                <a class="sidebar-user__perfil" asp-page="/Cuenta/Perfil" title="Mi perfil">
                    <span class="avatar-circle sm">@Usuario.Iniciales</span>
                    <span class="sidebar-user__copy">
                        <strong>@Usuario.Nombre</strong>
                        <small>@Usuario.Rol</small>
                    </span>
                </a>
                <form method="post" asp-page="/Cuenta/Logout" class="m-0">
                    <button type="submit" class="sidebar-user__salir" aria-label="Cerrar sesión" title="Cerrar sesión"><i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-toggle aria-hidden="true"></div>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Abrir menú" aria-controls="sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <p class="topbar-kicker">@marca.Nombre</p>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="topbar-actions">
                    <label class="global-search" aria-label="Buscar en el sistema">
                        <i class="bi bi-search"></i>
                        <input type="search" placeholder="Buscar socios, pagos, planes..." />
                    </label>

                    @await Component.InvokeAsync("SidebarMetricas", new { vista = "Alertas" })

                    @* Menú de perfil *@
                    <div class="dropdown">
                        <button class="user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de @Usuario.Nombre">
                            <div class="avatar">@Usuario.Iniciales</div>
                            <div class="user-meta">
                                <strong>@Usuario.Nombre</strong>
                                <small>@Usuario.Rol</small>
                            </div>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end profile-menu">
                            <div class="profile-menu__head">
                                <span class="avatar-circle">@Usuario.Iniciales</span>
                                <div class="min-w-0">
                                    <strong>@Usuario.Nombre</strong>
                                    <small>@@@Usuario.NombreUsuario · @Usuario.Rol</small>
                                    <small class="text-soft"><i class="bi bi-clock-history"></i> Último acceso: @(Usuario.AccesoAnterior is { } previo ? previo.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "primer ingreso")</small>
                                </div>
                            </div>
                            <a class="dropdown-item" asp-page="/Cuenta/Perfil"><i class="bi bi-person"></i> Mi perfil</a>
                            <a class="dropdown-item" asp-page="/Cuenta/CambiarPassword"><i class="bi bi-key"></i> Cambiar contraseña</a>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-page="/Cuenta/Logout">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content-panel" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>
    <script src="~/js/navegacion.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
