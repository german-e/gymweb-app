@page "{id:int}"
@using GymCore.Web.Pages.Socios
@model GymCore.Web.Pages.Socios.TarjetaModel
@{
    ViewData["Title"] = "Credencial de socio";
    var s = Model.R.Socio;
    var archivo = $"credencial-{SocioPresentacion.Numero(s.NumeroVisible)}";
}

<section class="page-shell">
    <div class="page-header d-print-none">
        <div>
            <a class="text-decoration-none small fw-semibold" asp-page="Detalle" asp-route-id="@s.Id"><i class="bi bi-arrow-left"></i> Ficha de @s.NombreCompleto</a>
            <h2>Credencial</h2>
            <p>Vista previa real de la tarjeta. Se imprime en tamaño CR80 (85,6 × 54 mm).</p>
        </div>
        <div class="header-actions">
            <button type="button" class="secondary-btn" data-cred-action="pdf" data-cred-target="#credencialImprimible" data-cred-file="@archivo"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            <button type="button" class="secondary-btn" data-cred-action="png" data-cred-target="#credencialImprimible" data-cred-file="@archivo"><i class="bi bi-image"></i> Imagen</button>
            <button type="button" class="primary-btn border-0" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
        </div>
    </div>

    <div class="credencial-stage">
        <partial name="Components/_Credencial" model='CredencialFactory.Desde(Model.R, id: "credencialImprimible")' />
    </div>

    <p class="text-center small text-muted d-print-none mb-0">
        Estado: <span class="status-pill @Model.R.Estado.Variante()">@Model.R.Estado.Texto()</span>
        · Código <strong class="num">@s.CodigoCredencial</strong>
    </p>
</section>

<style>
    .credencial-stage { display: grid; place-items: center; padding: clamp(16px, 5vw, 56px) 0; }
    .credencial-stage .credencial { max-width: 480px; }
    @@media print {
        @@page { size: 85.6mm 54mm; margin: 0; }
        .page-shell { gap: 0 !important; }
        .credencial-stage { padding: 0; display: block; }
        .credencial-stage .credencial { width: 85.6mm; max-width: none; height: 54mm; border-radius: 3mm; box-shadow: none; padding: 3mm 3.5mm 2.5mm; }
    }
</style>

@section Scripts {
    <script src="~/js/credencial.js" asp-append-version="true"></script>
    @if (Model.Imprimir)
    {
        <script>
            // Espera a que se dibuje el código de barras
            window.addEventListener('load', () => setTimeout(() => window.print(), 600));
        </script>
    }
}
