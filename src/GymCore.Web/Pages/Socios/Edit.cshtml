@page
@model GymCore.Web.Pages.Socios.EditModel
@{
    ViewData["Title"] = "Editar socio";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <a class="text-decoration-none small fw-semibold" asp-page="Detalle" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Volver a la ficha</a>
            <h2>Editar · @Model.Input.Nombre @Model.Input.Apellido</h2>
            <p>La credencial conserva su código actual aunque cambies el DNI.</p>
        </div>
    </div>

    <partial name="_SocioForm" model="Model" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
