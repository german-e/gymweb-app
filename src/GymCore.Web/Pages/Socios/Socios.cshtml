@page
@model GymCore.Web.Pages.Socios.SociosModel
@{
	ViewData["Title"] = "Socios";
}

<section class="container py-4">
	<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
		<div>
			<h1 class="h4 mb-1">Socios</h1>
			<p class="text-muted mb-0">Listado de socios y acciones rápidas.</p>
		</div>
		<div>
			<a class="btn btn-primary" asp-page="/Socios/Create">Nuevo socio</a>
		</div>
	</div>

	<form method="get" class="row g-2 align-items-center mb-3">
		<div class="col-12 col-md">
			<input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por DNI, apellido o nombre" />
		</div>
		<div class="col-12 col-md-auto">
			<button class="btn btn-outline-primary" type="submit">Buscar</button>
		</div>
	</form>

	<div class="card shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th style="width: 140px;">DNI</th>
						<th>Apellido</th>
						<th>Nombre</th>
						<th>Suscripción</th>
						<th style="width: 220px;" class="text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
				@if (Model.ListaSocios.Count == 0)
				{
					<tr>
						<td colspan="5" class="text-center text-muted py-4">No hay socios para mostrar</td>
					</tr>
				}
				else
				{
					foreach (var s in Model.ListaSocios)
					{
						<tr>
							<td>@s.Dni</td>
							<td>@s.Apellido</td>
							<td>@s.Nombre</td>
							<td>
								@{
									var info = Model.EstadoSuscripcionPorSocio.ContainsKey(s.Id) ? Model.EstadoSuscripcionPorSocio[s.Id] : (GymCore.Dominio.Enums.EstadoSuscripcion.Vencido, (DateTime?)null, (string?)null);
									var estado = info.Item1;
									var fecha = info.Item2;
									var planNombre = info.Item3;
									var badgeClass = estado == GymCore.Dominio.Enums.EstadoSuscripcion.Activo ? "success" : (planNombre == null ? "secondary" : "warning");
								}
								<span class="badge text-bg-@badgeClass">
									@(
										planNombre == null
											? "Sin suscripción"
											: (estado == GymCore.Dominio.Enums.EstadoSuscripcion.Activo ? "Activa" : "Vencida")
									)
								</span>
								@if (planNombre != null)
								{
									<div class="small text-muted mt-1">
										@planNombre
										@if (fecha.HasValue)
										{
											<span> · hasta @fecha.Value.ToString("dd/MM/yyyy")</span>
										}
									</div>
								}
							</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" asp-page="/Socios/Edit" asp-route-id="@s.Id">Editar</a>
								<a class="btn btn-sm btn-outline-danger" asp-page="/Socios/Delete" asp-route-id="@s.Id">Eliminar</a>
							</td>
						</tr>
					}
				}
				</tbody>
			</table>
		</div>
	</div>
</section>
