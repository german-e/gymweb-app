# Copiar a .env (no se versiona) y completar
DOMINIO=gym.midominio.com.ar
VERSION=1.0.0
GIMNASIO_NOMBRE=GymCore
# Contraseña de PostgreSQL: larga y aleatoria, solo letras y números (va dentro de la cadena de conexión).
# Generala con: openssl rand -hex 24
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-y-aleatoria
